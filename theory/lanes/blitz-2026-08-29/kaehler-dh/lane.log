+    exponent = float(np.polyfit(np.log(lengths), np.log(potentials), 1)[0])
+    curvature_gap = abs(window_curvature(0.5, kappa, 0.37, 80)
+                        - window_curvature(0.5, kappa, 0.37, 40))
+    lines.append(
