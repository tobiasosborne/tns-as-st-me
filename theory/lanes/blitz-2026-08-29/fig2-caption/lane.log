# ================================================================= FIG 2 ====
def fig2():
    fig, (a, b) = plt.subplots(
        2, 1, figsize=(W, 4.0), height_ratios=[1.0, 1.35],
        gridspec_kw=dict(hspace=0.32, left=0.155, right=0.97, top=0.965, bottom=0.095))
    ks = np.linspace(-0.36, 0.36, 1201)
    khs = [0.8, 1.5, 2.4]

    # (a) the remainder delta - 2 k_s: hard data enters only at O(k_s^2)
    a.axhline(0, ls="--", color=INK, lw=0.9, zorder=2)
    a.plot(ks, delta_phase(ks, 0.4) - 2 * ks, color=MUTED, lw=0.9, zorder=2)
    for kh, c in zip(khs, RAMP3):
        a.plot(ks, delta_phase(ks, kh) - 2 * ks, color=c, zorder=3)
    a.text(0.03, 0.05, r"universal part $2k_s$ removed", fontsize=7,
           color=INK, transform=a.transAxes)
    a.annotate(r"$\frac{v_h}{\omega_h}k_s^2$", xy=(0.255, delta_phase(np.array([0.255, 0.2551, 0.2552]), 0.8)[0] - 2 * 0.255),
               xytext=(0.13, 0.115), color=INK, fontsize=8,
               arrowprops=dict(arrowstyle="-", lw=0.5, color=MUTED))
    a.text(-0.20, 0.125, r"$k_h=0.4$", color=MUTED, fontsize=7)
    a.text(-0.325, 0.056, r"$0.8$", color=RAMP3[0], fontsize=7)
    a.text(-0.325, 0.028, r"$1.5$", color=RAMP3[1], fontsize=7)
    a.set_xlim(-0.36, 0.36); a.set_ylim(-0.16, 0.16)
    a.set_ylabel(r"$\delta(k_s,k_h)-2k_s$")
    a.set_xlabel(r"$k_s$", labelpad=1)
    a.text(0.03, 0.88, "(a)", transform=a.transAxes, fontsize=8, color=INK)

    # (b) exit displacement: pencil of curves through (0, -2)
    b.axhline(-2, ls="--", color=INK, lw=0.9, zorder=1)
    ksd = np.linspace(-0.36, 0.36, 1201)
    b.plot(ksd, displacement(ksd, 0.4), color=MUTED, lw=0.9, zorder=2)
    for kh, c in zip(khs, RAMP3):
        b.plot(ksd, displacement(ksd, kh), color=c, zorder=3)
    # wavepacket measurements (real-time dynamics)
    for r in FM:
        kh = r["k_h"]
        c = {0.8: RAMP3[0], 1.5: RAMP3[1], 2.4: RAMP3[2], 0.4: MUTED, 3.0: "#6b3fa0"}.get(kh)
        if c is None or kh == 3.0:
            continue
        b.errorbar(r["k_s"], r["displacement_soft_measured"],
                   yerr=r["displacement_soft_error"], fmt="o", ms=3.4,
                   mfc="white", mec=c, mew=0.9, ecolor=c, elinewidth=0.7,
                   capsize=1.5, zorder=4)
    # direct labels
    b.text(0.300, -2.02, r"$k_h=2.4$", color=RAMP3[2], fontsize=7, va="bottom")
    b.text(0.305, -2.52, r"$1.5$", color=RAMP3[1], fontsize=7, va="bottom")
    b.text(0.305, -3.28, r"$0.8$", color=RAMP3[0], fontsize=7, va="bottom")
    b.text(0.055, -4.55, r"$0.4$", color=MUTED, fontsize=7)
    b.annotate("universal:\n$-2$ sites", xy=(-0.27, -2.0), xytext=(-0.335, -2.95),
               color=INK, fontsize=7.5, ha="left",
               arrowprops=dict(arrowstyle="-", lw=0.5, color=MUTED))
    b.set_xlim(-0.36, 0.36); b.set_ylim(-5.15, -1.2)
    b.set_xlabel(r"soft momentum $k_s$", labelpad=1)
    b.set_ylabel(r"exit displacement $-\partial\delta/\partial k_s$  (sites)")
    b.text(0.03, 0.92, "(b)", transform=b.transAxes, fontsize=8, color=INK)
    save(fig, "fig2")


# ================================================================= FIG 3 ====

