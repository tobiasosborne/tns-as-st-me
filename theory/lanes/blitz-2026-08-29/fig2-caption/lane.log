\date{\today}

\begin{document}

\title{Elementary excitations in gapped quantum spin systems}
\author{Jutho Haegeman$^1$, Spyridon Michalakis$^{2}$, Bruno Nachtergaele$^{3}$, Tobias J.~Osborne$^4$, Norbert Schuch$^{5}$, Frank Verstraete$^{1,6}$}
\affiliation{$^1$Department of Physics and Astronomy,  Ghent University, Ghent, Belgium\\
$^2$Institute for Quantum Information and Matter, Caltech, Pasadena, USA\\
$^2$Department of Mathematics, University of California, Davis, USA\\
