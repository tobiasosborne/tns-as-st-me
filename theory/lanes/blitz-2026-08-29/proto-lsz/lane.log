+    print(f"PLSZ-C3 max quadratic coefficient = {c3b:.6e}")
+    print(f"PLSZ-C4 max invariant-sum error = {c4a:.6e}")
+    print(f"PLSZ-C4 min live linear-shift ratio = {c4b:.6e}")
