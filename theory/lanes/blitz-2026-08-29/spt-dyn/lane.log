+        edge_trace = profiles[:, : length // 2].sum(axis=1)
+        flip_prob = np.sum(np.abs(states @ flip_basis.conj()) ** 2, axis=1)
+
+        collision_i = int(np.argmin(centers[5:]) + 5)
