    orthogonality = np.linalg.norm(vectors.conj().T @ vectors - np.eye(dimension))
    projector = np.linalg.norm(vectors @ vectors.conj().T - np.eye(dimension))
    exact_spectrum = np.linalg.eigvalsh(hamiltonian)
