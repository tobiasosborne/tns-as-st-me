+DELTAS = (1.05, 1.5, 2.0, 4.0)
+WINDOWS = ((-10, 10, 0), (-7, 13, 2), (0, 9, 4), (-3, 2, -1))
+X0_GRID = np.linspace(-2.25, 3.25, 221)
