+    q, kappa = d16_parameters(delta)
+    abs_z_squared = q ** (-2.0 * x0)
+    kahler_mixed = 0.0
+    for n in range(a, b + 1):
+        q_to_2n = q ** (2 * n)
+        denominator = 1.0 + abs_z_squared * q_to_2n
+        kahler_mixed += q_to_2n / (denominator * denominator)
+    return 2.0 * kappa * abs_z_squared * kahler_mixed
+
+
