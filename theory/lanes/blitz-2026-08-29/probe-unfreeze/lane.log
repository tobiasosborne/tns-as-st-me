+def lower_at_site(coeffs: np.ndarray, n: int, m_from: int, two_s: int,
+                  site: int) -> np.ndarray:
+    """Apply one normalized-basis S^-_site without forming a source ansatz."""
+    weights = np.zeros(n, dtype=complex)
+    weights[site % n] = 1.0
