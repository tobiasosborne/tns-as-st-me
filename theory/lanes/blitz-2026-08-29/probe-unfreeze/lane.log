+    for m in soft_rows:
+        envelope = math.exp(-0.5 * ((ks[m] - 0.35) / 0.14) ** 2)
+        profile_x += envelope * np.exp(1j * ks[m] * np.arange(n))
+    phi0 = lowering_matrix(n, 1, two_s, profile_x) @ hard_vec
+    phi0 /= np.linalg.norm(phi0)
