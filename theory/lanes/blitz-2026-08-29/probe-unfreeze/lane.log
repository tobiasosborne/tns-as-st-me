import importlib.util, pathlib, numpy as np, math
p=pathlib.Path('theory/lanes/blitz-2026-08-29/probe-unfreeze/soft_index_probe.py')
s=importlib.util.spec_from_file_location('p',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)
def lower_site(coeff,n,mfrom,two_s,site):
 w=np.zeros(n,complex);w[site]=1
 return m.lowering_matrix(n,mfrom,two_s,w)@coeff
def dvec(n,two_s,hard,weights):
 out=np.zeros(len(m.sector_basis(n,3,two_s)),complex)
 for r,w in enumerate(weights):
  for a,b,c in ((0,1,1.),(1,2,-1.),(2,3,1.),(0,3,-1.)):
   t=lower_site(hard,n,1,two_s,(r+a)%n)
