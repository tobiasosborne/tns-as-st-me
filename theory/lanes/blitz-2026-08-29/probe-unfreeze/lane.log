+def d24_deformation_on_hard(n: int, two_s: int, hard_vec: np.ndarray,
+                            weights: np.ndarray) -> np.ndarray:
+    """D[f]|hard> in H_3 for the translated D24(e) deformation.
+
+    D24(e) fixes D=S^-_0S^-_1-S^-_1S^-_2+S^-_2S^-_3-S^-_0S^-_3.
