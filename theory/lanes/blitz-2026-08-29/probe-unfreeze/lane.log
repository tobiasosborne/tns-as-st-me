import importlib.util, math, pathlib
import numpy as np
p=pathlib.Path('theory/lanes/blitz-2026-08-29/probe-unfreeze/soft_index_probe.py')
s=importlib.util.spec_from_file_location('p',p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)

def datum(n,T):
    two_s=1; hard_idx=n//5; hk=2*np.pi/5
    basis=m.sector_basis(n,2,two_s); h2,_=m.hamiltonian(n,2,two_s)
    ks=2*np.pi*np.arange(n)/n
    mids=[i for i,k in enumerate(ks) if 0.12 < k < 0.72]
    hv=np.exp(1j*hk*np.arange(n))/np.sqrt(n)
    psi=np.zeros(len(basis),complex)
    for i in mids:
        k=ks[i]; fa=np.exp(-0.5*((k-.35)/.14)**2)
        psi += fa*(m.lowering_matrix(n,1,two_s,np.exp(1j*k*np.arange(n)))@hv)
    ev,U=np.linalg.eigh(h2); psit=U@(np.exp(-1j*ev*T)*(U.conj().T@psi))
    f0=np.fft.fft2(m.grid_wavefunction(psi,basis,n)); ft=np.fft.fft2(m.grid_wavefunction(psit,basis,n))
    om=1-np.cos(ks)
    free=f0*np.exp(-1j*np.add.outer(om,om)*T)
    cols=[j for j,k in enumerate(ks) if abs(k-hk)<.22]
    num=sum(ft[i,j]*np.conj(free[i,j]) for i in mids for j in cols)
    den=sum(abs(free[i,j])**2 for i in mids for j in cols)
    rr=num/den
    return mids,cols,rr,abs(rr-1)
for T in (1.,3.,6.,10.,15.):
 vals=[]
 for n in (10,15,20,25,30,35,40):
    mids,cols,rr,a=datum(n,T); vals.append(a)
 print('T',T,'vals',vals,'bound',max(vals)/np.median(vals))
