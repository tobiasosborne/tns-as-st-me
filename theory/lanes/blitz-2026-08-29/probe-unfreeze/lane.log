+    hard_vec = np.exp(1j * hard_k * np.arange(n)) / math.sqrt(n)
+    profile_x = np.zeros(n, dtype=complex)
+    for m in soft_rows:
+        envelope = math.exp(-0.5 * ((ks[m] - 0.35) / 0.14) ** 2)
+        profile_x += envelope * np.exp(1j * ks[m] * np.arange(n))
