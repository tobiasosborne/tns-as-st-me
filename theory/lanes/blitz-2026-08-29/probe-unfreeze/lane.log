+                    * (evecs.conj().T @ phi0))
+    f0 = np.fft.fft2(grid_wavefunction(phi0, basis2, n))
+    ft = np.fft.fft2(grid_wavefunction(phit, basis2, n))
+    s_val = two_s / 2.0
