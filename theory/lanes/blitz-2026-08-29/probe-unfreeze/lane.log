+            "ratio_imag": float(np.imag(ratio)),
+            "connected_abs": float(abs(ratio - 1.0)),
+            "free_row_mass": float(denominator),
+            "soft_rows": len(soft_rows), "hard_cols": len(hard_cols),
+            "settling_time": float(t_settle)}
+
