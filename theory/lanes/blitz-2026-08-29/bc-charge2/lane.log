+                                hopping_scale::Real=1.0)
+    tb = three_basis(N)
+    H3 = three_magnon_hamiltonian(tb, J; hopping_scale=hopping_scale)
+    H1 = one_magnon_hamiltonian(N, J)
+    rows = NamedTuple[]
+    syms = Float64[]
+    asym = Float64[]
+    for k in kmags
+        rp = collision_row(H3, H1, tb; ks=k, K=K, J=J, sigma=sigma)
+        rm = collision_row(H3, H1, tb; ks=-k, K=K, J=J, sigma=sigma)
+        push!(rows, rp); push!(rows, rm)
+        push!(syms, (rp.slope + rm.slope)/2)
+        push!(asym, abs(rp.slope-rm.slope)/2)
+    end
+    x1, x2 = kmags[1]^2, kmags[2]^2
+    slope = (syms[1]*x2 - syms[2]*x1)/(x2-x1)
+    fitshift = abs(slope-syms[1])
+    stderr = hypot(fitshift, maximum(asym)/2)
+    return (slope=slope, stderr=stderr, rows=rows, symmetric=syms,
+            asymmetry=asym, bethe_slope=fused_phase_slope(K))
+end
+
+end
