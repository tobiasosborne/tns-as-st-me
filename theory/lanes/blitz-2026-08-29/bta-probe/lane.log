+            "growth exponent >= 1.5 and |Omega_80-Omega_40| <= 1e-10",
+            {
+                "min_growth_exponent": min_exponent,
+                "max_curvature_change_40_to_80": max_curvature_change,
+                "growth_exponents": exponents,
