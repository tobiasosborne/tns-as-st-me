+        for delta in DELTAS:
+            area_grid = np.array([
+                area_per_lattice_period(delta, spin, x0=float(x0))
+                for x0 in X_GRID
+            ])
+            areas[f"S={spin},Delta={delta}"] = {
+                "min": float(area_grid.min()), "max": float(area_grid.max())
+            }
+            p3_error = max(p3_error, float(np.max(np.abs(area_grid - target))))
+
