    64	{\small 5-1-5 Kashiwanoha, Kashiwa, 277-8583, Japan}\\
    65	{\small e-mail: {\tt yasuyuki@ms.u-tokyo.ac.jp}}
    66	\\[0,3cm]
    67	{\sc Yoshiko Ogata}\footnote{Supported in part by
    68	the Inoue Foundation and the Grants-in-Aid for
    69	Scientific Research, JSPS.}\\
    70	{\small Graduate School of Mathematical Sciences}\\
    71	{\small The University of Tokyo, Komaba, Tokyo, 153-8914, Japan}
    72	\\[0,3cm]
    73	{\sc Erling St\o rmer}\\
    74	{\small Department of Mathematics, University of Oslo}\\
    75	{\small P.O.Box 1053 Blindern, NO-0316 Oslo, Norway}}
    76	
    77	\maketitle{}
    78	\centerline{\sl Dedicated to Masamichi Takesaki on the occasion of his
    79	eightieth birthday}
    80	\begin{abstract}
    81	Let $M$ be a factor of type III with separable predual and with normal
    82	states $\varphi_1,\dots,\varphi_k, \omega$ with $\omega$ faithful.  
    83	Let $A$ be a finite dimensional $C^*$-subalgebra of $M$. 
    84	Then it is shown that there is a unitary operator $u\in M$ such that 
    85	$\varphi_i \circ \Ad u = \omega$ on $A$ for $i=1,\dots,k$. 
    86	This follows from an embedding result of a finite dimensional
    87	$C^*$-algebra with a faithful state into $M$ with finitely many
    88	given states.  We also give similar embedding results of
    89	$C^*$-algebras and von Neumann algebras with faithful states
    90	into $M$.
    91	Another similar result for a factor of type II$_1$ instead
    92	of type III holds.
    93	\end{abstract}
    94	
    95	\section{Introduction}
    96	
    97	Let $M$ be a factor of type III with separable predual. Then two
    98	nonzero projections $e$ and $f$ in $M$ are equivalent, i.e.,
    99	there exists a partial isometry $v\in M$ such that $v^*v=e$,
   100	$vv^*=f$. If furthermore $e$ and $f$ are different from the
   101	identity operator $1$, then there is a unitary operator $u\in M$
   102	such that $u^* eu=f$. This shows that there is an abundance of
   103	unitaries in $M$, so one might expect stronger results arising
   104	from these unitaries. That is what is done in the present paper.
   105	We show that if $\varphi$ and $\omega$ are faithful normal states
   106	in $M$ and $A\subset M$ is a finite dimensional $C^*$-algebra,
   107	then there exists a unitary operator $u\in M$ such that the
   108	restrictions $\varphi\circ \Ad u \vert_A$ and $\omega\vert_A$
   109	are equal, where $\Ad u$ is the inner  automorphism
   110	$x\mapsto u^*xu$ of $M$. (See Corollary \ref{uni} for a
   111	more precise and general statement.)
   112	
   113	This actually follows from an embedding result of a finite
   114	dimensional $C^*$-algebra $A$ with a faithful state into $M$ with
   115	finitely given normal states.
   116	This result is then applied to obtain a similar result for the 
   117	$C^*$-algebra of the compact operators on a separable Hilbert space. 
   118	Furthermore, we have more general embedding results in
   119	Section \ref{embed} for $C^*$-algebras
   120	and von Neumann algebra with faithful states into a type III factor
   121	$M$ such that a finite number of normal states on $M$ coincide
   122	after the embedding.
   160	\section{Factors of type III}\label{three}
   161	
   162	In this section we state and prove our main result.
   163	
   164	\begin{thm}\label{ma}
   165	Let $M$ be a type III factor with separable predual and
   166	$\varphi_1,\dots,\varphi_k$ normal states on $M$.
   167	Let $A$ be a finite dimensional $C^*$-algebra and $\rho$ a faithful state on $A$.
   168	Then there exists a unital injective homomorphism $\pi:A\to M$ with
   169	\[
   170	\varphi_i\circ\pi=\rho,\quad i=1,\dots,k.
   171	\]
   172	\end{thm}
   173	
   174	After proving this theorem, we will prove that it
   175	implies the following corollary.
   176	
   177	\begin{cor}\label{uni}
   178	Let $M$ be a factor of type III with separable predual.
   179	Let $A$ be a finite dimensional $C^*$-subalgebra of $M$.
   180	Let $\varphi_1,\dots,\varphi_k$ and $\omega$ be normal states on $M$ and assume that $\omega$ is faithful.
   181	Then there exists a unitary operator $u\in M$ such that 
   182	\[
   183	\varphi_i\circ \Ad u\vert_A=\omega\vert_A,\quad i=1,\dots,k.
   184	\]
   185	\end{cor}
