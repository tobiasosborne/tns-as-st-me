   570	\subsection{The split property and projective representations}
   571	Next let us introduce the split property.
   572	\begin{defn}\label{split}
   573	Let $\omega$ be a pure state on $\caA$. Let $\omega_R$ be the restriction of
   574	$\omega$ to $\caA_R$, and $(\caH_{\omega_R},\pi_{\omega_R},\Omega_{\omega_R})$ be the GNS triple of $\omega_R$.
   575	We say $\omega$ satisfies the split property with respect to $\caA_L$ and $\caA_R$,
   576	if the von Neumann algebra $\pi_{\omega_R}(\caA_{R})''$ is a type I factor.
   577	We denote by $SP(\caA)$ the set of all pure states on $\caA$
   578	which satisfy the split property with respect to $\caA_L$ and $\caA_R$.
   579	We also denote by $SPG(\caA)$, the set of all states $\omega$ in $SP(\caA)$, which are 
   580	$\tau$-invariant.
   581	\end{defn}
   582	Recall that a type I factor is $*$-isomorphic to $B(\caK)$, the set of all bounded operators 
   583	on a  Hilbert space $\caK$. 
   584	See \cite{takesaki}.
   585	\begin{rem}\label{splitrem}
   586	Let $\omega$ be a pure state on $\caA$. 
   587	Let  $\omega_L$ be
   588	the restriction of $\omega$ to $\caA_L$.
   589	Then $\omega$ satisfies the split property if and only if 
   590	$\omega_{L}\otimes \omega_{R}$ is quasi-equivalent to $\omega$. ( See \cite{Matsui2}. In Proposition 2.2 of \cite{Matsui2}, it is assumed that the state is translationally invariant because of the first equivalent condition (i). However, the proof for the equivalence between
   591	(ii) and (iii) does not require translation invariance.)
   592	Therefore, by the symmetric argument, if $(\caH_{\omega_L},\pi_{\omega_L},\Omega_{\omega_L})$ is the GNS triple of $\omega_L$,
   593	the the split property of $\omega$ implies that $\pi_{\omega_L}(\caA_{L})''$ is also a type I factor.
   594	\end{rem}
   595	For each $\omega\in SPG(\caA)$, we may associate a second cohomology class of $G$.
   596	\begin{prop}\label{unieq}
   597	Let $\omega\in SPG(\caA)$ and ${\vp}=L,R$. 
   598	%and $(\caH_{\omega_{\vp}},\pi_{\omega_{\vp}},\Omega_{\omega_{\vp}})$ be the GNS triple of $\omega\vert_{\caA_{{\vp}}}$, the restriction of $\omega$ to $\caA_{\vp}$.
   599	Then
   600	there exists an irreducible $*$-representation  $\rho_{\omega,{\vp}}$ 
   601	of $\caA_{{\vp}}$ on a Hilbert space
   602	 $\caL_{\omega,{\vp}}$
   603	that is quasi-equivalent to the GNS representation 
   604	of $\omega\vert_{\caA_{{\vp}}}$.
   605	%Any such  irreducible $*$-representation are mutually unitarily equivalent.
   606	For each of such irreducible $*$-representation $(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}})$,
   607	there is a projective unitary representation $u_{\omega,{\vp}}$ of $G$ 
   608	on $\caL_{\omega,{\vp}}$ such that
   609	\begin{align}\label{uintro}
   610	\rho_{\omega,{\vp}}\circ \tau_{\vp}(g)
   611	=\Ad\lmk u_{\omega,{\vp}}(g)\rmk\circ \rho_{\omega,{\vp}},
   612	\end{align}
   613	for all  $g\in G$.
   614	Furthermore,
   615	if  another triple $(\tilde \caL_{\omega,{\vp}}, \tilde\rho_{\omega,{\vp}}, \tilde u_{\omega,{\vp}})$ satisfies the same conditions as $(\caL_{\omega,{\vp}}, 
   616	\rho_{\omega,{\vp}}, u_{\omega,{\vp}})$ above, then
   617	there is a unitary $W:\caL_{\omega,\vp}\to \tilde \caL_{\omega,\vp}$ and $c: G\to  \bbT$
   618	such that
   619	\begin{align}\label{Wp}
   620	\lmk \Ad W\rmk\circ  \rho_{\omega,\vp} =
   621	\tilde \rho_{\omega,\vp},
   622	  \end{align}
   623	 \begin{align}\label{cg}
   624	 c(g) \cdot \lmk \Ad W\rmk\lmk u_{\omega,\vp}(g)\rmk=\tilde u_{\omega,\vp}(g),\quad g\in G.
   625	 \end{align}
   626	In particular, 
   627	for $2$-cocycle $\sigma_{\omega,\vp}$, $\tilde \sigma_{\omega,\vp}$
   628	associated to $u_{\omega,\vp}$, $ \tilde u_{\omega,\vp}$ respectively,
   629	we have
   630	$[\sigma_{\omega,\vp}]_{H^{2}(G,\bbT)}=[\tilde \sigma_{\omega,\vp}]_{H^{2}(G,\bbT)}$.
   631	\end{prop}
   632	\begin{proof}
   633	Let $(\caH_{\omega_{\vp}},\pi_{\omega_{\vp}},\Omega_{\omega_{\vp}})$ be the GNS triple of $\omega\vert_{\caA_{{\vp}}}$.
   634	The existence of irreducible $*$-representation $(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}})$
   635	quasi-equivalent to $\pi_{\omega_{\vp}}$ 
   636	follows from the definition of the split property. 
   637	
   638	To see the existence of $ u_{\omega,\vp} $ satisfying (\ref{uintro})
   639	for such $(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}})$,
   640	let $\iota_{\omega,{\vp}}: \pi_{\omega_{\vp}}\lmk \caA_{\vp}\rmk''
   641	\to \caB(\caL_{\omega,{\vp}})$ be the $*$-isomorphism
   642	such that
   643	$\rho_{\omega,{\vp}}=\iota_{\omega,{\vp}}\circ  \pi_{\omega_{\vp}}$. 
   644	By the $\tau_{\vp}$-invariance of $\omega\vert_{\caA_{{\vp}}}$,
   645	the action $\tau_{\vp}$ of $G$ can be extended to an action
   646	$\hat\tau_{\vp}$ on $\pi_{\omega_{\vp}}\lmk \caA_{\vp}\rmk''$,
   647	so that $\hat\tau_{\vp}(g)\circ\pi_{\omega_{\vp}}=\pi_{\omega_{\vp}}\circ \tau_{\vp}(g)$,
   648	for $g\in G$.
   649	By the Wigner Theorem, the $*$-automorphism $\iota_{\omega,{\vp}}\circ \hat\tau_{\vp}(g)\circ
   650	\iota_{\omega,{\vp}}^{-1}$ on $\caB(\caL_{\omega,{\vp}})$
   651	is given by a unitary $ u_{\omega,\vp} (g)$
   652	so that
   653	\begin{align}
   654	\iota_{\omega,{\vp}}\circ \hat\tau_{\vp}(g)\circ
   655	\iota_{\omega,{\vp}}^{-1}
   656	=\Ad\lmk u_{\omega,\vp} (g)
   657	\rmk,\quad g\in G.
   658	\end{align}
   659	As $\hat \tau_{\vp}$ is an action of $G$, $u_{\omega,\vp}$ is a projective unitary representation.
   660	We obtain (\ref{uintro}) by
   661	\begin{align}
   662	\rho_{\omega,{\vp}}\circ \tau_{\vp}(g)
   663	=\iota_{\omega,{\vp}}\circ  \pi_{\omega_{\vp}}\circ \tau_{\vp}(g)
   664	=\iota_{\omega,{\vp}}\circ  \hat\tau_{\vp}(g)\circ\pi_{\omega_{\vp}}
   665	=\iota_{\omega,{\vp}}\circ  \hat\tau_{\vp}(g)\circ\iota_{\omega,{\vp}}^{-1}\circ
   666	\iota_{\omega,{\vp}}\circ\pi_{\omega_{\vp}}
   667	=\Ad\lmk u_{\omega,{\vp}}(g)\rmk\circ \rho_{\omega,{\vp}}.
   668	\end{align}
   669	
   670	Suppose that $(\tilde \caL_{\omega,{\vp}}, \tilde\rho_{\omega,{\vp}}, \tilde u_{\omega,{\vp}})$ satisfies the same conditions as $(\caL_{\omega,{\vp}}, 
   671	\rho_{\omega,{\vp}}, u_{\omega,{\vp}})$.
   672	Then by the Wigner Theorem, there exists a unitary $W:\caL_{\omega,\vp}\to \tilde \caL_{\omega,\vp}$
   673	satisfying (\ref{Wp}).
   674	Note that
   675	\begin{align}
   676	\Ad\lmk \tilde u_{\omega,{\vp}}(g)\rmk\circ \tilde \rho_{\omega,{\vp}}
   677	=
   678	\tilde \rho_{\omega,{\vp}}\circ \tau_{\vp}(g)
   679	=\Ad W\circ  \rho_{\omega,\vp} 
   680	\circ \tau_{\vp}(g)
   681	=\Ad W\circ 
   682	\Ad\lmk u_{\omega,{\vp}}(g)\rmk
   683	\circ \Ad W^*\circ \tilde \rho_{\omega,{\vp}}.
   684	\end{align}
   685	This implies that $\tilde u_{\omega,{\vp}}(g)^*\Ad W\lmk u_{\omega,{\vp}}(g) \rmk$
   686	belongs to $\bbT\unit_{\tilde \caL_{\omega,\vp}}$ proving (\ref{cg}).
   687	\end{proof}
   688	\begin{defn}\label{pao}Let $\omega\in SPG(\caA)$ and
   689	$(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}}, u_{\omega,{\vp}})$ 
   690	be a triple satisfying the conditions in Proposition \ref{unieq}.
   691	Let $\sigma_{\omega,{\vp}}$ be the $2$-cocycle associated to
   692	$u_{\omega,{\vp}}$.
   693	We call 
   694	$(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}}, u_{\omega,{\vp}},\sigma_{\omega,{\vp}})$  
   695	a quadruple associated to $(\omega\vert_{\caA_{{\vp}}},\tau_{\vp})$.
   696	Furthermore, we denote the second cohomology class $[\sigma_{\omega,{\vp}}]_{H^{2}(G,\bbT)}$
   697	by $c_{\omega,\zeta}$, and call it the second cohomology class of $G$ associated to
   698	$(\omega\vert_{\caA_{{\vp}}},\tau_{\vp})$.
   699	\end{defn}
   700	\begin{rem}\label{rem17}
   701	For a quadruple $(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}}, u_{\omega,{\vp}},\sigma_{\omega,{\vp}})$
   702	 associated to $(\omega\vert_{\caA_{{\vp}}},\tau_{\vp})$
   703	 and any map $b:G\to\bbT$,
   704	 $(\caL_{\omega,{\vp}}, \rho_{\omega,{\vp}}, b\cdot u_{\omega,{\vp}},\sigma_{b}\sigma_{\omega,{\vp}})$
   705	 is also a quadruple associated to  
   706	 $(\omega\vert_{\caA_{{\vp}}},\tau_{\vp})$.
   707	 See (\ref{bound}) and Notation \ref{bfvee}.
   708	\end{rem}
   709	
   710	
   711	\subsection{Main Theorem}
   712	Let us introduce $\ainn^{G} (A_{\vp})$.
   713	\begin{defn}
   714	Let $\vp=L,R$.
   715	An automorphism $\Xi_{\vp}$ of $\caA_{\vp}$ is asymptotically inner in $\caA_{\vp}^{G}$
   716	if there is a norm continuous path $w_{\vp}:[0,\infty)\to \caU\lmk\caA_{\vp}^{G}\rmk$
   717	with $w_{\vp}(0)=\unit_{\caA_{\vp}}$
   718	 that 
   719	\begin{align}
   720	\Xi_{\vp}(a)=\lim_{t\to\infty}\Ad\lmk w_{\vp}(t)\rmk(a),\quad
   721	a\in \caA_{\vp}.
   722	\end{align}
   723	We denote by $\ainn^{G} (A_{\vp})$ the set of all automorphisms which are
   724	 asymptotically inner in $\caA_{\vp}^{G}$.
   725	\end{defn}
   726	In this paper, we consider the classification problem of $SPG(\caA)$
   727	with respect to the following equivalence relation.
   728	\begin{defn}
   729	For $\omega_{0}$, $\omega_{1}\in SPG(\caA)$, we
   730	write $\omega_{0}\sim_{{\rm split},\tau}\omega_{1}$
   731	if there exist automorphisms $\Xi_{L}\in \ainn^{G}(\caA_{L})$ 
   732	and $\Xi_{R}\in \ainn^{G}(\caA_{R})$ such that
   733	$\omega_{1}$ and $\omega_{0}\circ\lmk\Xi_{L}\otimes \Xi_{R}\rmk$
   734	are quasi-equivalent.
   735	\end{defn}
   736	
   737	Now we are ready to state our main theorem.
   738	\begin{thm}\label{main}
   739	For  $\omega_{0}$, $\omega_{1}\in SPG(\caA)$,
   740	 %Let $(\caL_{\omega_i,{R}}, \rho_{\omega_i,{R}}, u_{\omega_i,{R}},\sigma_{\omega_i,{R}})$, for
   741	%$i=0,1$
   742	%be projective representations of $G$ associated to $(\omega_i\vert_{\caA_{{R}}},\tau_{R,G})$.
   743	$\omega_{0}\sim_{{\rm split},\tau}\omega_{1}$
   744	if and only if
   745	$c_{\omega_{1},R}=c_{\omega_{0},R}$.
   746	
   747	\end{thm}
   748	The ''only if'' part of the Theorem \ref{main} is easy to prove.
   749	 In order to prove ''if'' part of the Theorem, we note that
   750	if $c_{\omega_{1},R}=c_{\omega_{0},R}$ holds,
   751	 $\omega_{0}$ and $\omega_{1}$
   752	give covariant representations of a twisted $C^{*}$-dynamical systems 
   753	 $\Sigma_{\Gamma_{R}}^{(\sigma_{R})}$, $\Sigma_{\Gamma_{L}}^{(\sigma_{L})}$
   754	 (see section \ref{crossedproduct}), where
   755	 $\sigma_{R}$, $\sigma_{L}$ are
   756	  $2$-cocycles of $G$  such that
   757	 $[\sigma_{R}]_{H^{2}(G,\bbT)}=c_{\omega_{1},R}=c_{\omega_{0},R}$
   758	 and $[\sigma_{L}]_{H^{2}(G,\bbT)}=c_{\omega_{1},L}=c_{\omega_{0},L}$.
   759	 (See Remark \ref{rem17} and Lemma \ref{clmcr}.)
   760	 One of the basic idea is to encode the information of these 
   761	 $2$-cocycles $\sigma_{R}$, $\sigma_{L}$
   762	 into $C^{*}$-algebras we consider.
   763	 Namely, instead of considering $\caA_{R}$, $\caA_{L}$,we consider 
   764	 the  the twisted crossed products $C^{*}(\Sigma_{\Gamma_{R}}^{(\sigma_{R})})$,
   765	 $C^{*}(\Sigma_{\Gamma_{L}}^{(\sigma_{L})})$.
   766	 We recall the twisted crossed product $C^{*}(\Sigma_{\Gamma}^{(\sigma)})$ of $\Sigma_{\Gamma}^{(\sigma)}$ in section \ref{crossedproduct}.
   767	 In section  \ref{projsec}, we show that
   768	for any $\omega\in SPG(\caA)$, and $\vp=L,R$, $u_{\omega,{\vp}}$
   769	contains all elements of $\caP_{\sigma_{\omega,{\vp}}}$.
