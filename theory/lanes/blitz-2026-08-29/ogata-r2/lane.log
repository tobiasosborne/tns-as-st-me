   590	%\\
   591	
   592	We introduce $\bbZ_2$-index for pure time reversal invariant state satisfying the split property.
   593	Let us first recall the definition of the split property.
   594	We here give the following definition of the split property, which is most suitable for our purpose.
   595	It corresponds to the standard definition \cite{dl} in our setting (see \cite{Matsui2}).
   596	%See Definition~1.1 of \cite{Matsui2} for a different characterization, which is more physically motivated.
   597	\begin{defn}
   598	Let $\varphi$ be a pure state on $\caA$. Let $\varphi_R$ be the restriciton of
   599	$\varphi$ to $\caA_R$, and $(\caH_{\varphi_R},\pi_{\varphi_R},\Omega_{\varphi_R})$ be the GNS triple of $\varphi_R$.
   600	We say $\varphi$ satisfies the split property with respect to $\caA_L$ and $\caA_R$,
   601	if the von Neumann algebra $\pi_{\varphi_R}(\caA_{R})''$ is a type I factor.
   602	\end{defn}
   603	Recall that a type I factor is isomorphic to $B(\caK)$, the set of all bounded operators 
   604	on a  Hilbert space $\caK$. 
   605	See \cite{takesaki}.
   606	
   607	\begin{thm}\label{sp}
   608	Let $\varphi$ be a time reversal invariant pure state on $\caA$, which satisfies the split property. Let $\varphi_R$ be the restriciton of
   609	$\varphi$ to $\caA_R$, and $(\caH_{\varphi_R},\pi_{\varphi_R},\Omega_{\varphi_R})$ be the GNS triple of $\varphi_R$.
   610	
   611	%Let $(\caH_{\varphi_R},\pi_{\varphi_R},\Omega_{\varphi_R})$ be the GNS triple of $\varphi_R$, the restriction of $\varphi$ to $\caA_R$.
   612	% Assume that the von Neumann algebra $\pi_{\varphi_R}\lmk \caA_R\rmk{''}$ is a type I factor.
   613	Then there are a Hilbert space $\caK_\varphi$, a $*$-isomorphism $\iota_\varphi : \pi_{\varphi_R}\lmk \caA_R\rmk{''}\to B(\caK_{\varphi})$,
   614	and an antiunitary $J_{\varphi}$ on $\caK_{\varphi}$ such that
   615	\begin{align*}
   616	\iota_\varphi\circ \pi_{\varphi_R}\circ\Xi_R\lmk A\rmk
   617	=J_\varphi \lmk \iota_\varphi \circ\pi_{\varphi_R}\lmk A\rmk\rmk J_\varphi^*,\quad
   618	A\in\caA_R.
   619	\end{align*}
   620	Futhermore, $J_\varphi^2=\sigma_\varphi\unit$, with $\sigma_\varphi=1$ or $\sigma_\varphi=-1$.
   621	These $\caK_\varphi$, $\iota_\varphi$, $J_{\varphi}$ are unique in the following sense.: 
   622	If  a Hilbert space  $\tilde \caK_\varphi$, a $*$-isomorphism $\tilde\iota_\varphi : \pi_{\varphi_R}\lmk \caA_R\rmk{''}\to B(\tilde \caK_{\varphi})$,
   623	and an antiunitary $\tilde J_{\varphi}$ on $\tilde \caK_{\varphi}$ satisfy
   624	\begin{align*}
   625	\tilde \iota_\varphi\circ \pi_{\varphi_R}\circ\Xi_R\lmk A\rmk
   626	=\tilde J_\varphi \lmk \tilde \iota_\varphi \circ\pi_{\varphi_R}\lmk A\rmk\rmk {\tilde J_\varphi}^*,\quad
   627	A\in\caA_R,
   628	\end{align*}
   629	then
   630	there is a unitary $W:\caK_\varphi\to \tilde \caK_\varphi$ and $e^{i\theta}\in \bbT$
   631	such that
   632	\begin{align*}
   633	&W\lmk \iota_\varphi \lmk x\rmk\rmk W^*=
   634	\tilde \iota_\varphi \lmk x\rmk,
   635	 \quad x\in \pi_{\varphi_R}\lmk \caA_R\rmk{''},\\
   636	&e^{i\theta} WJ_\varphi W^*=\tilde J_\varphi.
   637	 \end{align*}
   638	In particular, $\tilde {J_\varphi}^2=\sigma_\varphi\unit$.
   639	\end{thm}
   640	From this Theorem we may define the $\bbZ_2$-index for pure time reversal invariant state satisfying the split property.
   641	\begin{defn}\label{indexsp}
   642	%Let $\varphi$ be a unique $\alpha^\Phi$-ground state of a time reversal invariant interaction $\Phi\in \caB_f$ 
   643	%and suppose that its associated bulk Hamiltonian $H_{\varphi,\Phi}$ has a spectral gap. 
   644	From Theorem \ref{sp}, for each time reversal invariant pure state
   645	$\varphi$ on $\caA$ with the split property,
   646	we obtain a $\bbZ_2$-index associated to $\varphi$. We denote this $\bbZ_2$-index by $\sigma_\varphi\in\{-1,1\}$.
   647	% Throughout this paper,
   648	%$\sigma_\varphi$ will be used to denote this index associated to the state $\varphi$.
   649	%Hence, for each interaction $\Phi$ with unique ground state $\varphi$ with gapped bulk Hamiltonian,
   650	%we can associate some $\hat\sigma_\Phi:=\sigma_\varphi\in\{-1,1\}$.
   651	\end{defn}
   652	We will prove Theorem \ref{sp} in section \ref{split}.
   653	In section \ref{c1main}, we will see that we may associate this index to time reversal invariant models
   654	with unique gapped ground state.
   655	In section \ref{oshikawa}, we will prove that the index introduced by Pollmann et.al. \cite{po}
   656	is the index in Definition \ref{indexsp}, in the special setting, i.e., for matrix product states.
   657	
   658	Having an index, natural question to ask is if it is an invariant of some classification.
   659	We show that this index is an invariant of the classification with respect to the {\it factorizable automorphic equivalence, preserving the time reversal symmetry}. First, let us define the automorphic equivalence preserving the time reversal symmetry.
   660	\begin{defn}\label{aet}
   661	Let $\varphi_1,\varphi_2$ be two time reversal invariant states on $\caA$.
   662	We say $\varphi_2$ is automorphic equivalent to $\varphi_1$
   663	via a time reversal invariant automorphism
   664	%, preserving the time reversal symmetry,
   665	%preserving the time reversal symmetry,
   666	if there exists an automorphism $\alpha$ on $\caA$ such that
   667	%its time reversal invariant factorization $(\alpha_R,\alpha_L,W)$ such that
   668	\begin{align}
   669	\varphi_2=\varphi_1\circ \alpha\quad\text{and}\quad
   670	\alpha\circ\Xi=\Xi\circ\alpha.
   671	\end{align}
   672	\end{defn}
   673	%\begin{rem}
   674	%Without the time reversal symmetry, any states on $\caA$ are automorphic equivalent to each others.\cite{pow}
   675	%\end{rem}
   676	\begin{defn}\label{adt}
   677	We say an automorphism $\alpha$ of $\caA$ is factorizable if there are automorphisms $\alpha_R$,
   678	$\alpha_L$ on $\caA_R$, $\caA_L$ respectively, and a unitary $W$ in $\caA$
   679	such that
   680	\[
   681	\alpha\circ\lmk\alpha_L^{-1}\otimes \alpha_R^{-1}\rmk(A)=
   682	WAW^*,\quad A\in\caA.
   683	\]
   684	We call these $(\alpha_R,\alpha_L,W)$, a factorization of $\alpha$.
   685	When $\alpha$ is time reversal invariant, i.e., $\Xi\circ \alpha=\alpha\circ\Xi$,
   686	we say a factorization $(\alpha_R,\alpha_L,W)$ of $\alpha$
   687	is time reversal invariant, if $\alpha_R\circ\Xi_R=\Xi_R\circ\alpha_R$ and
   688	$\alpha_L\circ\Xi_L=\Xi_L\circ\alpha_L$.
   689	When such factorization exists, we say that $\alpha$ allows a time reversal invariant factorization.
   690	\end{defn}
   691	 
   692	
   693	\begin{thm}\label{aei}
   694	Let $\varphi_1,\varphi_2$ be time reversal invariant pure states satisfying the split property.
   695	Suppose that $\varphi_1$ and $\varphi_2$ 
   696	are automorphic equivalent via a time reversal invariant automorphism
   697	which allows a time reversal invariant factorization.
   698	Then the $\bbZ_2$-indices $\sigma_{\varphi_1}$,  $\sigma_{\varphi_2}$associated to
   699	$\varphi_1$, $\varphi_2$ (in Definition \ref{indexsp}) are equal.
   700	\end{thm}
   701	We will prove this theorem in section \ref{split}.
   702	In the next section, we see that this theorem can be applied to the setting of $C^1$-classification of gapped Hamiltonians.
   703	Therefore, the $\bbZ_2$-index is an invariant of the $C^1$-classification.
   704	{\new{Any time reversal unique gapped ground states satisfy the conditions of Theorem \ref{aei}.
   705	In particular, we may apply Theorem \ref{aei} to time reversal invariant matrix product states.
   706	}}
   707	
