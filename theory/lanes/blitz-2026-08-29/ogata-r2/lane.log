  2774	As in Theorem \ref{sp}, it is unique up to unitary conjugacy and a phase, and the cohomology class is independent of the choice of the projective representation.
  2775	\begin{thm}
  2776	Let $\varphi$ be a $G$-invariant pure state on $\caA$, which satisfies the split property. Let $\varphi_R$ be the restriciton of
  2777	$\varphi$ to $\caA_R$, and $(\caH_{\varphi_R},\pi_{\varphi_R},\Omega_{\varphi_R})$ be the GNS triple of $\varphi_R$.
  2778	%Let $(\caH_{\varphi_R},\pi_{\varphi_R},\Omega_{\varphi_R})$ be the GNS triple of $\varphi_R$, the restriction of $\varphi$ to $\caA_R$.
  2779	% Assume that the von Neumann algebra $\pi_{\varphi_R}\lmk \caA_R\rmk{''}$ is a type I factor.
  2780	Then there are a Hilbert space $\caK_\varphi$, a $*$-isomorphism $\iota_\varphi : \pi_{\varphi_R}\lmk \caA_R\rmk{''}\to B(\caK_{\varphi})$,
  2781	and a projective unitary representation $U_\varphi:G\to\caU(\caK_\varphi)$ on $\caK_{\varphi}$ such that
  2782	\begin{align*}
  2783	\iota_\varphi\circ \pi_{\varphi_R}\circ T_{g,R}\lmk A\rmk
  2784	=U_\varphi(g) \lmk \iota_\varphi \circ\pi_{\varphi_R}\lmk A\rmk\rmk U_\varphi(g)^*,\quad
  2785	A\in\caA_R,\quad g\in G.
  2786	\end{align*}
  2787	These $\caK_\varphi$, $\iota_\varphi$, $U_{\varphi}$ are unique in the following sense.: 
  2788	If  a Hilbert space  $\tilde \caK_\varphi$, a $*$-isomorphism $\tilde\iota_\varphi : \pi_{\varphi_R}\lmk \caA_R\rmk{''}\to B(\tilde \caK_{\varphi})$,
  2789	and a projective unitary representation $\tilde U_\varphi:G\to\caU(\tilde \caK_\varphi)$ on $\tilde\caK_{\varphi}$ satisfy
  2790	\begin{align*}
  2791	\tilde \iota_\varphi\circ \pi_{\varphi_R}\circ T_{g,R}\lmk A\rmk
  2792	=\tilde U_\varphi(g) \lmk \tilde \iota_\varphi \circ\pi_{\varphi_R}\lmk A\rmk\rmk {\tilde U_\varphi(g)}^*,\quad
  2793	A\in\caA_R,\quad g\in G,
  2794	\end{align*}
  2795	then
  2796	there is a unitary $W:\caK_\varphi\to \tilde \caK_\varphi$ and $c: G\to  \bbT$
  2797	such that
  2798	\begin{align*}
  2799	&W\lmk \iota_\varphi \lmk x\rmk\rmk W^*=
  2800	\tilde \iota_\varphi \lmk x\rmk,
  2801	 \quad x\in \pi_{\varphi_R}\lmk \caA_R\rmk{''},\\
  2802	& c(g) WU_\varphi(g) W^*=\tilde U_\varphi(g),\quad g\in G.
  2803	 \end{align*}
  2804	In particular, the cohomology class of $U_\varphi$ is equal to that of $\tilde U_{\varphi}$.
  2805	\end{thm}
  2806	The same argument as the proof of Theorem \ref{aei} shows that the cohomology class is an invariant
  2807	of
  2808	factorizable automorphic equivalence, preserving $G$-symmetry. 
  2809	\begin{thm}
  2810	Let $\varphi_1,\varphi_2$ be $G$-invariant pure states satisfying the split property.
  2811	Suppose that there 
  2812	 exists an automorphism $\alpha$ on $\caA$ such that
  2813	\begin{align}
  2814	\varphi_2=\varphi_1\circ \alpha\quad\text{and}\quad
  2815	\alpha\circ T_g=T_g\circ\alpha,\quad g\in G.
  2816	\end{align}
  2817	Furthermore, assume that there are automorphisms
  2818	$\alpha_R$,
  2819	$\alpha_L$ on $\caA_R$, $\caA_L$ respectively, and a unitary $W$ in $\caA$
  2820	such that
  2821	\begin{align}
  2822	\alpha_R\circ T_{g,R}=T_{g,R}\circ\alpha_R,\quad g\in G
  2823	\end{align}
  2824	and
  2825	\[
  2826	\alpha\circ\lmk\alpha_L^{-1}\otimes \alpha_R^{-1}\rmk(A)=
  2827	WAW^*,\quad A\in\caA.
  2828	\]
  2829	Then the 
  2830	 the cohomology class of the associated projective representations of $\varphi_1$ and 
  2831	 $\varphi_2$ are equal.
  2832	 \end{thm}
  2833	From this, we can show that the cohomology class is invariant of $C^1$-classification.
  2834	\begin{thm}
  2835	Let $\Phi:[0,1]\ni s \to \Phi(s):=\{\Phi(X;s)\}_{X\in {\mathfrak S}_\bbZ}\in {\caB_f}$ be a $C^1$-path of
  2836	interactions, satisfying the {\it Condition B} 
  2837	with
  2838	\begin{center}
  2839	{\it 6'.} For each $s\in[0,1]$, $\Phi(s)$ is $G$-invariant i.e.,
  2840	\[
  2841	T_g\lmk \Phi(X;s)\rmk=\Phi(X;s),\quad g\in G,\quad X\in\mathfrak S_\bbZ,
  2842	\]
  2843	\end{center}
  2844	instead of {\it 6}.
  2845	Then
  2846	the cohomology class of the associated representation of the ground state
  2847	 does not change along the path.
  2848	\end{thm}
