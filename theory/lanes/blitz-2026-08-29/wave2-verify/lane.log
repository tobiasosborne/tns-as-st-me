    73	module LambdaDMemory
    74	
    75	using LinearAlgebra
    76	using Printf
    77	using Logging
    78	using TensorKit
    79	using MPSKit
    80	
    81	include(joinpath(@__DIR__, "lambdaD_model.jl"))
    82	using .LambdaD
    83	
    84	export neel_vacua, kink_dispersion, group_velocity, kink_packet, vacuum_window,
    85	       staggered_profile, wall_estimators, window_charge_law, coset_certificate,
    86	       window_energy, KinkSector, kink_sector,
    87	       MemoryResult, memory_experiment, memory_record, trajectory_velocity
    88	
    89	# ===========================================================================
    90	# The two Néel vacua
    91	# ===========================================================================
    92	
    93	"""
    94	    neel_vacua(psi) -> (psiA, psiB, s)
    95	
    96	Orient a converged two-site-cell Néel uMPS so that the staggered density
    97	`n_x = (−1)^{x+1}⟨S^z_x⟩` is **positive** on `psiA`, and return the Z₂ partner
    98	`psiB` (the same state shifted by one site, on which `n_x` is negative) together
    99	with the measured tail density `s = |n_x|`.
   100	
   101	The orientation matters: VUMPS picks one of the two broken vacua at random from
   102	the seed, and every sign convention below (D13(a)'s `s_α = +s` at `−∞`) is tied
   103	to `psiA` being the `+s` one.
   104	"""
   105	function neel_vacua(psi::InfiniteMPS)
   106	    length(psi) == 2 || throw(ArgumentError("Néel vacua need a two-site unit cell"))
   107	    ops = LambdaD.spin1_ops(:none)
   108	    sz = [real(expectation_value(psi, i => ops.Sz)) for i in 1:2]
   109	    shifted = InfiniteMPS([psi.AL[2], psi.AL[3]])
   110	    psiA, psiB = sz[1] >= 0 ? (psi, shifted) : (shifted, psi)
   111	    szA = [real(expectation_value(psiA, i => ops.Sz)) for i in 1:2]
   112	    s = (szA[1] - szA[2]) / 2                     # = ⟨n_x⟩ on psiA, both sites
   113	    s > 0 || throw(ArgumentError("orientation failed: staggered density $s ≤ 0"))
   114	    return psiA, psiB, s
   115	end
   116	
   117	"""
   118	    KinkSector
   119	
   120	Everything the transport protocol needs about the topological sector: the two
   121	vacua, their environments, the measured tail density `s`, and the vacuum bond
   122	energy used to zero the window energy.
   123	"""
   124	struct KinkSector
   125	    point::LambdaD.LambdaDPoint
   126	    chi::Int
   127	    psiA::InfiniteMPS
   128	    psiB::InfiniteMPS
   129	    H::Any
   130	    envA::Any
   131	    envB::Any
   132	    s::Float64
   133	    e_bond::Float64
   134	    h2::Any
   135	end
   136	
   137	"""
   138	    kink_sector(point; chi, tol=1e-10, seed=20260829) -> KinkSector
   139	
   140	Ground state at `point` on a two-site cell (trivial-symmetry backend, because
   141	the window construction needs both vacua in the *same* virtual spaces), oriented
   142	by [`neel_vacua`](@ref).
   143	"""
   144	function kink_sector(point::LambdaD.LambdaDPoint = LambdaD.NEEL_POINT;
   145	                     chi::Int = 16, tol::Real = 1.0e-10, seed::Int = 20260829,
   146	                     maxiter::Int = 800)
   147	    res = LambdaD.find_gs(point; chi = chi, unitcell = 2, symmetry = :none,
   148	                          seed = seed, tol = tol, maxiter = maxiter)
   149	    res.converged || @warn "kink_sector: ground state not converged" ε = res.galerkin
   150	    psiA, psiB, s = neel_vacua(res.psi)
   151	    H = res.H
   152	    ops = LambdaD.spin1_ops(:none)
   153	    P = ops.P
   154	    h2d = point.J .* (ops.XXd .+ point.Delta .* ops.ZZd)
   155	    point.K == 0 || throw(ArgumentError("kink transport is defined for K = 0 only"))
   156	    point.D == 0 || throw(ArgumentError("kink transport is defined for D = 0 only"))
   157	    h2 = TensorMap(copy(h2d), P ⊗ P ← P ⊗ P)
   158	    e_bond = real(expectation_value(psiA, (1, 2) => h2))
   159	    envA = environments(psiA, H)
   160	    envB = environments(psiB, H)
   161	    return KinkSector(point, chi, psiA, psiB, H, envA, envB, s, e_bond, h2)
   162	end
   163	
   164	# ===========================================================================
   165	# Kink dispersion in the topological sector
   166	# ===========================================================================
   167	
   168	"""
   169	    kink_dispersion(sec, ks; num=1) -> (energies, states)
   170	
   171	`ω(k)` for the domain-wall excitation, from MPSKit's `QuasiparticleAnsatz` with
   172	`left_gs = ψ_A` and `right_gs = ψ_B`.  Because the two ground states differ, the
   173	ansatz is in the topologically nontrivial sector and the returned state is a
   174	kink, not a magnon.
   175	
   176	`momentum` is per SITE in MPSKit's convention (the transfer systems carry
   177	`exp(i k n_cell)` with `n_cell` the cell length).  For this model `ω` has period
   178	`π`: a one-site translation maps the `A|B` sector to `B|A`, and the Z₂ spin flip
   179	maps it back, so `ω(k) = ω(k+π)` exactly.  The Brillouin zone is `(−π/2, π/2]`.
   180	"""
   181	function kink_dispersion(sec::KinkSector, ks::AbstractVector{<:Real}; num::Int = 1)
   182	    Es = Vector{Vector{Float64}}(undef, length(ks))
   183	    states = Vector{Any}(undef, length(ks))
   184	    for (i, k) in enumerate(ks)
   185	        E, phi = with_logger(NullLogger()) do
   186	            excitations(sec.H, QuasiparticleAnsatz(), Float64(k),
   187	                        sec.psiA, sec.envA, sec.psiB, sec.envB; num = num)
   188	        end
   189	        Es[i] = real.(collect(E))[1:num]
   190	        states[i] = phi[1]
   191	    end
   192	    return Es, states
   193	end
   194	
   195	"""
   196	    group_velocity(sec, k0; dk=0.02) -> (v, ω0)
   197	
   198	Central-difference `dω/dk` at `k0` from three `QuasiparticleAnsatz` solves, in
   199	SITES per unit time.  This is the number the measured wavepacket velocity is
   200	tested against.
   201	"""
   202	function group_velocity(sec::KinkSector, k0::Real; dk::Real = 0.02)
   203	    Es, _ = kink_dispersion(sec, [k0 - dk, k0, k0 + dk]; num = 1)
   204	    v = (Es[3][1] - Es[1][1]) / (2dk)
   205	    return v, Es[2][1]
   206	end
   207	
   208	# ===========================================================================
   209	# The kink wavepacket, as a WindowMPS
   210	# ===========================================================================
   211	
   212	function _dense3(t)
   213	    a = convert(Array, t)
   214	    return reshape(a, size(a, 1), size(a, 2), :)
   215	end
   216	
   217	"""
   218	    kink_packet(sec, phi; L, x0, sigma, k0, dressing=:qp) -> WindowMPS
   219	
   220	A Gaussian kink wavepacket on a window of `L` sites, with `ψ_A` frozen to its
   221	left and `ψ_B` frozen to its right.
   222	
   223	The construction is the standard block form of a one-particle superposition,
   224	
   225	    T[x] = [ A[x]   g(x)·B[x] ;
   226	             0      Bvac[x]   ] ,   g(x) = e^{−(x−x0)²/4σ²} e^{i k₀ x},
   227	
   228	with `A = ψ_A.AL`, `Bvac = ψ_B.AR`, and `B` the **variationally optimised**
   229	excitation tensor of the quasiparticle solution `phi` at momentum `k₀`
   230	(`dressing = :qp`).  The left boundary of the window is forced into the `A`
   231	block and the right boundary into the `B` block, so the wall is created exactly
   232	once, with amplitude `g(x)`; the bond dimension is `2χ`.
   233	
   234	`dressing = :sharp` replaces `B[x]` by `Bvac[x]` — the *sharp junction*, i.e. a
   235	step from one vacuum straight to the other with no dressing at all.  It is kept
   236	because it is the control the HANDOFF's dressed-kink discipline demands: a sharp
   237	wall is not a one-kink state (its energy is far above the band) and reporting it
   238	as one fakes agreement.  Never use it for physics.
   239	"""
   240	function kink_packet(sec::KinkSector, phi; L::Int, x0::Real, sigma::Real,
   241	                     k0::Real, dressing::Symbol = :qp)
   242	    dressing in (:qp, :sharp) ||
   243	        throw(ArgumentError("dressing must be :qp or :sharp, got $dressing"))
   244	    L >= 4 || throw(ArgumentError("window too short"))
   245	    chi = dim(left_virtualspace(sec.psiA, 1))
   246	    P = LambdaD.spin1_ops(:none).P
   247	    A = [convert(Array, sec.psiA.AL[i]) for i in 1:2]
   248	    Bv = [convert(Array, sec.psiB.AR[i]) for i in 1:2]
   249	    Bq = dressing === :qp ? [_dense3(phi[i]) for i in 1:2] : Bv
   250	    g(x) = exp(-(x - x0)^2 / (4 * sigma^2)) * cis(k0 * x)
   251	
   252	    Vc = ComplexSpace(chi)
   253	    V2 = ComplexSpace(2chi)
   254	    tens = map(1:L) do x
   255	        c = mod1(x, 2)
   256	        if x == 1
   257	            T = zeros(ComplexF64, chi, 3, 2chi)
   258	            T[:, :, 1:chi] .= A[c]
   259	            T[:, :, (chi + 1):2chi] .= g(x) .* Bq[c]
   260	            TensorMap(T, Vc ⊗ P ← V2)
   261	        elseif x == L
   262	            T = zeros(ComplexF64, 2chi, 3, chi)
   263	            T[1:chi, :, :] .= g(x) .* Bq[c]
   264	            T[(chi + 1):2chi, :, :] .= Bv[c]
   265	            TensorMap(T, V2 ⊗ P ← Vc)
   266	        else
   267	            T = zeros(ComplexF64, 2chi, 3, 2chi)
   268	            T[1:chi, :, 1:chi] .= A[c]
   269	            T[(chi + 1):2chi, :, (chi + 1):2chi] .= Bv[c]
   270	            T[1:chi, :, (chi + 1):2chi] .= g(x) .* Bq[c]
   271	            TensorMap(T, V2 ⊗ P ← V2)
   272	        end
   273	    end
   274	    psi = WindowMPS(sec.psiA, FiniteMPS(tens), sec.psiB)
   275	    normalize!(psi)
   276	    return psi
   277	end
   278	
   279	"Vacuum window (`ψ_A` everywhere, no wall) — the energy reference."
   280	function vacuum_window(sec::KinkSector, L::Int)
   281	    tens = [sec.psiA.AL[mod1(x, 2)] for x in 1:L]
   282	    return WindowMPS(sec.psiA, FiniteMPS(tens), sec.psiA)
   283	end
   284	
   285	# ===========================================================================
   286	# Window observables
   287	# ===========================================================================
   288	
   289	"`⟨n_x⟩ = (−1)^{x+1}⟨S^z_x⟩` on every site of the window."
   290	function staggered_profile(psi)
   291	    Sz = LambdaD.spin1_ops(:none).Sz
   292	    return [(-1)^(x + 1) * real(expectation_value(psi, x => Sz)) for x in 1:length(psi)]
   293	end
   294	
   295	"""
   296	    wall_estimators(n, s, W) -> NamedTuple
   297	
   298	Three wall-position estimators from one staggered profile `n`, in the spirit of
   299	`spins_memory_sector.jl`'s `X̂₁/X̂₂/X̂₃`:
   300	
   301	* `X1` — D13(a) exactly: `a − 1 + (2s)^{-1}Σ_{x∈W}(n_x + s)` on the measurement
   302	  window `W = a:b`.  Uses `s`; **saturates** at `a−1` and `b` once the wall
   303	  leaves `W`, which is why D13(a) demands the core padded from both edges.
   304	* `X2` — centroid of the wall density `w_x = (n_x − n_{x+1})/2s` over the whole
   305	  TDVP window.  The normalisation `Σw` divides out, so `X2` is **independent of
   306	  `s`**: this is the estimator that makes the `δx = −(2s)^{-1}⟨ν⟩` coefficient
   307	  test a test and not an identity.
   308	* `X3` — linear-interpolated zero crossing of `n_x`, also `s`-free.
   309	
   310	`wall_weight` is `Σ_x w_x` — one for a single wall fully inside the window.
   311	"""
   312	function wall_estimators(n::AbstractVector{<:Real}, s::Real, W::AbstractUnitRange{Int})
   313	    a, b = first(W), last(W)
   314	    X1 = a - 1 + sum(n[x] + s for x in W) / (2s)
   315	    w = [(n[x] - n[x + 1]) / (2s) for x in 1:(length(n) - 1)]
   316	    tot = sum(w)
   317	    X2 = abs(tot) > 1e-8 ? sum((x + 0.5) * w[x] for x in eachindex(w)) / tot : NaN
   318	    X3 = NaN
   319	    for x in 1:(length(n) - 1)
   320	        if n[x] > 0 >= n[x + 1]
   321	            X3 = x + n[x] / (n[x] - n[x + 1])
   322	            break
   323	        end
   324	    end
   325	    return (X1 = X1, X2 = X2, X3 = X3, wall_weight = tot, wall_density = w)
   326	end
   327	
   328	"""
   329	    window_charge_law(psi, W; weight=1.0) -> (values, probs)
   330	
   331	The law of `Σ_{x∈W} weight·n_x` on `psi`, obtained by exact discrete Fourier
   332	inversion of the characteristic function
   333	`χ(θ) = ⟨∏_{x∈W} e^{iθ·weight·n_x}⟩` on the integer grid `−|W| … |W|`.
   334	
   335	`weight = 1` is the windowed staggered charge `Q^int_W = Σ_{x∈W}n_x`, and the
   336	inversion is then **exact**: `Q^int_W` is a sum of commuting on-site operators
   337	with integer spectrum, so the grid is its whole spectrum and the returned
   338	`probs` is a genuine probability distribution.  The D13(a) charge
   339	`Q̂_{W,c₀} = Σ_{x∈W}(n_x − s_γ(x))` is `Q^int_W` shifted by a c-number
   340	(row LD-ID), so this is its law up to that shift.
   341	
   342	`weight = 1/(2s)` is the **red control**: it returns the same inversion applied
   343	to the D13(a) wall coordinate `𝔛_W` (up to a shift), whose spectrum is in
   344	`(2s)^{-1}ℤ` and therefore *not* in one coset of `ℤ`.  The inversion is then an
   345	aliased signed measure and acquires negative entries.  The wall displacement is
   346	not quantised; the charge is.  That contrast is the numerical content of
   347	M-INDEX-fin here, and `min(probs)` is the number that carries it.
   348	"""
   349	function window_charge_law(psi, W::AbstractUnitRange{Int}; weight::Real = 1.0)
   350	    nw = length(W)
   351	    M = 2nw + 1
   352	    thetas = [2pi * j / M for j in 0:(M - 1)]
   353	    cf = [_phase_expectation(psi, W, th, weight) for th in thetas]
   354	    vals = collect(-nw:nw)
   355	    probs = [real(sum(cis(-th * v) * c for (th, c) in zip(thetas, cf))) / M
   356	             for v in vals]
   357	    return vals, probs
   358	end
   359	
   360	"""
   361	    coset_certificate(psi, W, s, c0) -> NamedTuple
   362	
   363	`⟨e^{2πiQ̂_{W,c₀}}⟩` and `⟨e^{2πi𝔛_W}⟩` measured on `psi`.
   364	
   365	The first has modulus 1 and phase `2πκ_{W,c₀}` — equivalently
   366	`⟨e^{2πiQ^int_W}⟩ = 1`, which is what `charge_phase_defect` measures — with
   367	`κ_{W,c₀} = −s(2c₀−a−b+1)`, which is exactly "`spec Q̂_{W,c₀}` lies in one coset
   368	of `ℤ`" (M-INDEX-fin's (G-IDX.0), certified arithmetically).  The second has
   369	modulus **strictly below 1** whenever `2s ∉ ℤ`: the wall coordinate itself is
   370	not quantised.  `charge_modulus`, `charge_phase_defect` and `position_modulus`
   371	are the three numbers the test shard asserts on.
   372	"""
   373	function coset_certificate(psi, W::AbstractUnitRange{Int}, s::Real, c0::Int)
   374	    a, b = first(W), last(W)
   375	    kappa = -s * (2c0 - a - b + 1)
   376	    zq = _phase_expectation(psi, W, 2pi, 1.0) * cis(2pi * kappa)
   377	    zx = _phase_expectation(psi, W, 2pi, 1 / (2s))
   378	    d = angle(zq) - 2pi * kappa
   379	    phase_defect = abs(d - 2pi * round(d / (2pi)))
   380	    return (charge_modulus = abs(zq), charge_phase_defect = phase_defect,
   381	            kappa = kappa, position_modulus = abs(zx))
   382	end
   383	
   384	"⟨∏_{x∈W} exp(iθ·w·n_x)⟩, contracted directly along the window."
   385	function _phase_expectation(psi, W::AbstractUnitRange{Int}, theta::Real, w::Real)
   386	    ops = LambdaD.spin1_ops(:none)
   387	    P = ops.P
   388	    szdiag = diag(convert(Array, ops.Sz))
   389	    u(x) = TensorMap(ComplexF64.(diagm(cis.(theta * w * (-1)^(x + 1) .* szdiag))), P ← P)
   390	    a = first(W)
   391	    AC = psi.AC[a]
   392	    ua = u(a)
   393	    @tensor v[-1; -2] := AC[1 3; -2] * ua[4; 3] * conj(AC[1 4; -1])
   394	    for x in (a + 1):last(W)
   395	        AR = psi.AR[x]
   396	        ux = u(x)
   397	        @tensor vn[-1; -2] := v[1; 2] * AR[2 3; -2] * ux[4; 3] * conj(AR[1 4; -1])
   398	        v = vn
   399	    end
   400	    return @tensor v[1; 1]
   401	end
   402	
   403	"""
   404	    window_energy(sec, psi) -> Float64
   405	
   406	`Σ_{x=1}^{L−1}⟨h_{x,x+1}⟩ − (L−1)e_bond`: the energy carried by the window
   407	relative to the vacuum.  At `D = 0` the Hamiltonian has no on-site term, so this
   408	is the whole of it apart from the two frozen boundary bonds, whose drift is the
   409	honest measure of when the packet has reached the edge.
   410	"""
   411	function window_energy(sec::KinkSector, psi)
   412	    L = length(psi)
   413	    e = sum(real(expectation_value(psi, (x, x + 1) => sec.h2)) for x in 1:(L - 1))
   414	    return e - (L - 1) * sec.e_bond
   415	end
