     1	"""
     2	    LambdaDEdge
     3	
     4	Edge memory in the **Haldane** phase against the **large-D** phase of the same
     5	λ–D Hamiltonian (`src/lambdaD_model.jl`, bd `tns-f5r`, wave 2, deliverable 2).
     6	
     7	The two points are `Δ = 1, D = 0` (Haldane, SPT) and `Δ = 1, D = 2.5` (large-D,
     8	trivial).  They have the same symmetry and the same bulk order parameters up to
     9	smooth drift; what separates them is the **protected edge spin-½** of the
    10	Haldane phase, which is what this shard measures — dynamically, as a memory.
    11	
    12	PROTOCOL (λD-EDGE-MEM).
    13	
    14	  1. Open chain of `L` sites.  A **permanent** field `h_R S^z_L` pins the right
    15	     edge for the whole run, so that whatever the left edge does is unambiguous.
    16	     The default is `h_R = −h_L`: the two edges are then pinned OPPOSITELY, the
    17	     run sits in the `S^z_tot = 0` sector in **both** phases, and `m_L` is a
    18	     genuine measurement rather than half of a conserved total.  (With
    19	     `h_R = +h_L` the preparation is reflection symmetric and `m_L = S^z_tot/2`
    20	     identically — a symmetry artifact, not a measurement.  Do not use that
    21	     setting to claim a contrast.)
    22	  2. Preparation: the DMRG ground state of `H + h_L S^z_1 + h_R S^z_L`.  This is
    23	     the `t < 0` half of a boundary field pulse, applied adiabatically.
    24	  3. At `t = 0` the left field is switched off.  Everything after that is
    25	     evolution under `H + h_R S^z_L` alone.
    26	  4. Readout: `m_L(t) = Σ_{x=1}^{ℓ}⟨S^z_x⟩` over the left half (`ℓ = L÷2`) —
    27	     a windowed charge, and the natural "did the edge remember?" observable,
    28	     since `S^z_tot` is conserved and the right edge is pinned.  Also recorded:
    29	     the on-site `⟨S^z_1⟩` and the whole profile.
    30	
    31	WHAT THE CONTRAST IS.  In the Haldane phase the left edge carries a free
    32	spin-½; the pulse selects one of its two states, and after the field is gone
    33	that choice is (up to the exponentially small edge–edge splitting `∼e^{−L/ξ}`)
    34	a conserved label.  `m_L` therefore stays put, near `∓½`.  In the large-D phase
    35	there is no edge mode: the field only polarises the boundary linearly, and once
    36	it is switched off the induced moment radiates into the bulk and `m_L` decays.
    37	The record reports `m_L(0)`, `m_L(t_end)`, the retention `m_L(t_end)/m_L(0)`
    38	and `mL_absmax`.  The honest reading of the measured contrast is the ABSOLUTE
    39	one: in the Haldane phase `m_L` sits at `−½` and stays there; in the large-D
    40	phase `m_L` never leaves `≈ 0`, so its *relative* retention is a ratio of two
    41	numerical zeros and means nothing.  `mL_initial`, `mL_final` and `mL_absmax`
    42	are the numbers to quote; `retention` is kept only because it is meaningful on
    43	the Haldane side.
    44	
    45	The local moment tells the same story from the other side: `⟨S^z_1⟩` relaxes
    46	substantially in BOTH phases once the field is off (the polarisation cloud
    47	radiates into the bulk).  What distinguishes them is that in the Haldane phase
    48	the *windowed* charge `m_L` does not follow it down — the half unit stays on
    49	the edge — whereas in large-D there was never a half unit to lose.
    50	
    51	HONEST SCOPE.  A finite open chain has an exponentially small edge–edge
    52	splitting, so Haldane retention is exact only up to times `∼e^{L/ξ}`; `L`, `ξ`
    53	and the run time are all in the record.  `chi_max` truncation and TDVP2 error
    54	are reported through the energy drift of the post-pulse Hamiltonian, which is
    55	conserved exactly in the continuum protocol.
    56	"""
    57	module LambdaDEdge
    58	
    59	using LinearAlgebra
    60	using Printf
    61	using Logging
    62	using TensorKit
    63	using MPSKit
    64	
    65	include(joinpath(@__DIR__, "lambdaD_model.jl"))
    66	using .LambdaD
    67	
    68	export finite_hamiltonian, EdgeResult, edge_experiment, edge_record
    69	
    70	"""
    71	    finite_hamiltonian(p, L; hL=0.0, hR=0.0) -> FiniteMPOHamiltonian
    72	
    73	Open chain of `L` spin-1 sites carrying the λ–D Hamiltonian of `p` plus boundary
    74	fields `hL·S^z_1` and `hR·S^z_L`.  Same two-site and on-site terms as
    75	`LambdaD.hamiltonian`; only the boundary conditions and the two fields differ,
    76	so nothing is redefined.
    77	"""
    78	function finite_hamiltonian(p::LambdaD.LambdaDPoint, L::Int; hL::Real = 0.0,
    79	                            hR::Real = 0.0)
    80	    L >= 4 || throw(ArgumentError("need L ≥ 4"))
    81	    ops = LambdaD.spin1_ops(:none)
    82	    P = ops.P
    83	    h2d = p.J .* (ops.XXd .+ p.Delta .* ops.ZZd)
    84	    h2 = TensorMap(copy(h2d), P ⊗ P ← P ⊗ P)
    85	    p.K == 0 || (h2 = h2 + (p.J * p.K) * (ops.SS * ops.SS))
    86	    lattice = fill(P, L)
    87	    terms = Any[(x, x + 1) => h2 for x in 1:(L - 1)]
    88	    if p.D != 0
    89	        for x in 1:L
    90	            push!(terms, x => p.D * ops.Sz2)
    91	        end
    92	    end
    93	    hL == 0 || push!(terms, 1 => hL * ops.Sz)
    94	    hR == 0 || push!(terms, L => hR * ops.Sz)
    95	    return FiniteMPOHamiltonian(lattice, terms)
    96	end
    97	
    98	"""Result of one `edge_experiment` run."""
    99	struct EdgeResult
   100	    params::NamedTuple
   101	    times::Vector{Float64}
   102	    mL::Vector{Float64}
   103	    sz1::Vector{Float64}
   104	    energy::Vector{Float64}
   105	    norm::Vector{Float64}
   106	    profile0::Vector{Float64}
   107	    profile_end::Vector{Float64}
   108	    E_prep::Float64
   109	    gs_converged::Bool
   110	    gs_residual::Float64
   111	end
   112	
   113	"""
   114	    edge_experiment(p; L, chi, hL, hR, dt, nsteps, sample_every, chi_max,
   115	                    edge_window=nothing, verbose=false) -> EdgeResult
   116	
   117	Run λD-EDGE-MEM at the parameter point `p`.  `edge_window` defaults to `1:L÷2`.
   118	"""
   119	function edge_experiment(p::LambdaD.LambdaDPoint; L::Int = 40, chi::Int = 48,
   120	                         hL::Real = 0.5, hR::Real = -0.5, dt::Real = 0.1,
   121	                         nsteps::Int = 200, sample_every::Int = 10,
   122	                         chi_max::Int = 64, edge_window = nothing,
   123	                         gs_tol::Real = 1.0e-8, gs_maxiter::Int = 300,
   124	                         verbose::Bool = false)
   125	    ops = LambdaD.spin1_ops(:none)
   126	    P = ops.P
   127	    Wl = edge_window === nothing ? (1:(L ÷ 2)) : edge_window
   128	    Hprep = finite_hamiltonian(p, L; hL = hL, hR = hR)
   129	    Hrun = finite_hamiltonian(p, L; hL = 0.0, hR = hR)
   130	
   131	    psi0 = FiniteMPS(rand, ComplexF64, L, P, ComplexSpace(chi))
   132	    quiet(f) = with_logger(f, verbose ? current_logger() : NullLogger())
   133	    psi, envs, eps = quiet() do
   134	        find_groundstate(psi0, Hprep,
   135	                         DMRG2(; tol = gs_tol, maxiter = gs_maxiter, verbosity = 0,
   136	                               trscheme = truncrank(chi)))
   137	    end
   138	    E_prep = real(expectation_value(psi, Hprep))
   139	    converged = eps <= gs_tol
   140	
   141	    alg = TDVP2(; trscheme = truncrank(chi_max))
   142	    renvs = environments(psi, Hrun)
   143	    ts = Float64[]; mL = Float64[]; sz1 = Float64[]; en = Float64[]; nm = Float64[]
   144	    prof(st) = [real(expectation_value(st, x => ops.Sz)) for x in 1:L]
   145	    profile0 = prof(psi)
   146	    function sample!(t)
   147	        pr = prof(psi)
   148	        push!(ts, t)
   149	        push!(mL, sum(pr[x] for x in Wl))
   150	        push!(sz1, pr[1])
   151	        push!(en, real(expectation_value(psi, Hrun, renvs)))
   152	        push!(nm, norm(psi))
   153	        verbose && @printf("t=%6.2f  mL=%+8.5f  sz1=%+8.5f  E=%12.7f\n",
   154	                           t, mL[end], sz1[end], en[end])
   155	        return nothing
   156	    end
   157	    sample!(0.0)
   158	    for step in 1:nsteps
   159	        psi, renvs = timestep(psi, Hrun, 0.0, dt, alg, renvs)
   160	        step % sample_every == 0 && sample!(step * dt)
   161	    end
   162	
   163	    params = (point = p, L = L, chi = chi, hL = Float64(hL), hR = Float64(hR),
   164	              dt = Float64(dt), nsteps = nsteps, sample_every = sample_every,
   165	              chi_max = chi_max, edge_window = (first(Wl), last(Wl)))
   166	    return EdgeResult(params, ts, mL, sz1, en, nm, profile0, prof(psi),
   167	                      E_prep, converged, Float64(eps))
   168	end
   169	
   170	_c(x::Real) = isfinite(x) ? Float64(x) : nothing
   171	_c(v::AbstractVector{<:Real}) = [_c(x) for x in v]
   172	
   173	"""
   174	    edge_record(r::EdgeResult) -> Dict{String,Any}
   175	
   176	JSON-ready record: parameters, the `m_L` history, and the three summary numbers
   177	`mL_initial`, `mL_final`, `retention`.
   178	"""
   179	function edge_record(r::EdgeResult)
   180	    p = r.params
   181	    m0 = r.mL[1]; m1 = r.mL[end]
   182	    return Dict{String, Any}(
   183	        "protocol" => "lambdaD-edge-memory",
   184	        "label" => p.point.label, "J" => p.point.J, "Delta" => p.point.Delta,
   185	        "D" => p.point.D, "K" => p.point.K,
   186	        "L" => p.L, "chi" => p.chi, "chi_max" => p.chi_max,
   187	        "hL" => p.hL, "hR" => p.hR, "dt" => p.dt, "nsteps" => p.nsteps,
   188	        "sample_every" => p.sample_every,
   189	        "edge_window" => collect(p.edge_window),
   190	        "gs_converged" => r.gs_converged, "gs_residual" => _c(r.gs_residual),
   191	        "E_prep" => _c(r.E_prep),
   192	        "times" => _c(r.times), "mL" => _c(r.mL), "sz1" => _c(r.sz1),
   193	        "energy" => _c(r.energy), "norm" => _c(r.norm),
   194	        "energy_drift" => _c(maximum(abs.(r.energy .- r.energy[1]))),
   195	        "mL_initial" => _c(m0), "mL_final" => _c(m1),
   196	        "mL_absmax" => _c(maximum(abs, r.mL)),
   197	        "mL_drift" => _c(m1 - m0),
   198	        "retention" => _c(abs(m0) > 1e-6 ? m1 / m0 : NaN),
   199	        "sz1_initial" => _c(r.sz1[1]), "sz1_final" => _c(r.sz1[end]),
   200	        "profile_initial" => _c(r.profile0),
   201	        "profile_final" => _c(r.profile_end),
   202	    )
   203	end
   204	
   205	end # module LambdaDEdge

