   419	end # module LambdaDMemory
     1	# lambdaD_memory_run.jl — the kink-transport / memory protocol.  Shard 2 of
     2	# `LambdaDMemory`; included by src/lambdaD_memory.jl (no module wrapper of its
     3	# own, the TriangleMPS.jl shard convention).
     4	#
     5	# PROTOCOL (λD-KINK-MEM).  Everything is at Δ = 2.5, D = 0, on the two-site
     6	# Néel cell.
     7	#
     8	#   1. `kink_sector` — the two Z₂ vacua ψ_A (staggered density +s) and ψ_B (−s),
     9	#      and the measured tail density s = m_stag.
    10	#   2. `group_velocity` — the kink band ω(k) at k₀ ± dk in the *topological*
    11	#      sector, giving v = dω/dk.  Fixed BEFORE the dynamics: the measured packet
    12	#      velocity is tested against it, not fitted to it.
    13	#   3. `kink_packet`  — a Gaussian kink wavepacket at (x₀, σ, k₀), dressed by the
    14	#      optimised quasiparticle tensor.
    15	#   4. window-TDVP — TDVP2 on the WindowMPS with ψ_A / ψ_B frozen outside.
    16	#   5. at every sample: the staggered profile, the three wall estimators, the
    17	#      exact law of the windowed staggered charge on the fixed measurement
    18	#      window W, the window energy, and the wall weight within `edge_guard`
    19	#      sites of either end (`edge_leak` — the honest end of the run).
    20	#
    21	# WHAT IS TESTED, and why each is not a tautology.
    22	#
    23	#   (a) integer support.  `charge_modulus = |⟨e^{2πiQ̂_{W,c₀}}⟩| = 1` and the
    24	#       phase equals 2πκ_{W,c₀}: the windowed charge lies in ONE coset of ℤ, so
    25	#       every escaped-charge outcome ν = q(t_-) − q(t_+) is an integer
    26	#       (M-INDEX-fin).  The *red control* in the same call is
    27	#       `position_modulus = |⟨e^{2πi𝔛_W}⟩| < 1`: the wall coordinate is not
    28	#       quantised.  Same state, same window, opposite verdict.
    29	#   (b) the coefficient.  δx measured by the s-FREE centroid estimator X2 is
    30	#       compared with −(2s)^{-1}⟨ν⟩ from the charge history.  s enters the right
    31	#       side only; agreement is a measurement of the coefficient 2s, and the
    32	#       naive value 2 (which is what "spin-1 ⇒ 2s = 2" would give) is off by
    33	#       4 % here because s = m_stag = 0.9603, not 1.  `coefficient_measured`
    34	#       reports −⟨ν⟩/δx(X2) as measured.
    35	#   (c) group velocity.  dX2/dt against dω/dk.
    36	#   (d) energy conservation and norm, as TDVP quality gates.
    37	#
    38	# WHAT IS NOT DONE (stated, not hidden).  The ordered TPM law of D27 with a
    39	# genuine first projective measurement at t_- is NOT computed: doing it needs
    40	# one TDVP run per charge branch.  What is recorded is the exact single-time law
    41	# at each sample and the mean escaped charge ⟨ν⟩ = ⟨Q̂_W⟩(t_-) − ⟨Q̂_W⟩(t_+).
    42	# That equals the TPM first moment iff D27(LR2) holds — an assumption, recorded
    43	# as such in the JSON under `caveats`.
    44	
    45	"""One sample of the kink-transport run."""
    46	struct MemorySample
    47	    t::Float64
    48	    X1::Float64
    49	    X2::Float64
    50	    X3::Float64
    51	    wall_weight::Float64
    52	    Q_int::Float64
    53	    Q_hat::Float64
    54	    energy::Float64
    55	    norm::Float64
    56	    edge_leak::Float64
    57	    charge_law::Vector{Float64}
    58	    profile::Vector{Float64}
    59	end
    60	
    61	"""Result of one `memory_experiment` run."""
    62	struct MemoryResult
    63	    params::NamedTuple
    64	    s::Float64
    65	    omega0::Float64
    66	    v_theory::Float64
    67	    samples::Vector{MemorySample}
    68	    charge_values::Vector{Int}
    69	    cert_initial::NamedTuple
    70	    cert_final::NamedTuple
    71	    packet_energy::Float64
    72	    v_measured::Float64
    73	    v_fit_window::Tuple{Float64, Float64}
    74	    dx_X1::Float64
    75	    dx_X2::Float64
    76	    dx_X3::Float64
    77	    energy_drift_readout::Float64
    78	    nu_mean::Float64
    79	    dx_from_charge::Float64
    80	    coefficient_measured::Float64
    81	    t_minus::Float64
    82	    t_plus::Float64
    83	    readout_index::Tuple{Int, Int}
    84	end
    85	
    86	"""
    87	    trajectory_velocity(ts, X, window) -> Float64
    88	
    89	Least-squares slope of `X` against `t` over `window = (lo, hi)`.  Same estimator
    90	as `spins_memory_run.jl`'s trajectory fit, restricted to one clean interval.
    91	"""
    92	function trajectory_velocity(ts::AbstractVector, X::AbstractVector, window::Tuple)
    93	    idx = findall(i -> window[1] <= ts[i] <= window[2] && isfinite(X[i]), eachindex(ts))
    94	    length(idx) >= 2 || return NaN
    95	    tt = ts[idx]; xx = X[idx]
    96	    tb = sum(tt) / length(tt); xb = sum(xx) / length(xx)
    97	    den = sum((t - tb)^2 for t in tt)
    98	    den > 0 || return NaN
    99	    return sum((tt[i] - tb) * (xx[i] - xb) for i in eachindex(tt)) / den
   100	end
   101	
   102	"""
   103	    memory_experiment(sec; L, W, c0, x0, sigma, k0, dt, nsteps, sample_every,
   104	                      chi_max, edge_guard, dk, dressing, verbose) -> MemoryResult
   105	
   106	Run the λD-KINK-MEM protocol on the sector `sec`.
   107	
   108	Arguments that fix the geometry: `L` window sites, measurement window
   109	`W = a:b ⊂ 1:L` with cut `c0 ∈ W`, packet centre `x0`, width `sigma`, momentum
   110	`k0`.  `t_minus` / `t_plus` are chosen as the first and last sample at which the
   111	wall (estimator `X1`) is padded from both edges of `W` by at least `sigma`, so
   112	that D13(a)'s padding requirement holds at both readout times; if no such pair
   113	exists the run reports `NaN` displacements rather than a number computed outside
   114	the definition's scope.
   115	"""
   116	function memory_experiment(sec::KinkSector; L::Int = 64, W::AbstractUnitRange{Int} = 12:52,
   117	                           c0::Union{Int, Nothing} = nothing, x0::Real = 20.0,
   118	                           sigma::Real = 4.0, k0::Real = pi / 4, dt::Real = 0.1,
   119	                           nsteps::Int = 100, sample_every::Int = 5,
   120	                           chi_max::Int = 48, edge_guard::Int = 6, dk::Real = 0.02,
   121	                           leak_tol::Real = 1.0e-3, dressing::Symbol = :qp,
   122	                           verbose::Bool = false)
   123	    first(W) >= 1 && last(W) <= L || throw(ArgumentError("W must lie inside 1:L"))
   124	    cut = c0 === nothing ? (first(W) + last(W)) ÷ 2 : c0
   125	    cut in W || throw(ArgumentError("c0 must lie in W"))
   126	
   127	    v_theory, omega0 = group_velocity(sec, k0; dk = dk)
   128	    _, phis = kink_dispersion(sec, [k0]; num = 1)
   129	    psi = kink_packet(sec, phis[1]; L = L, x0 = x0, sigma = sigma, k0 = k0,
   130	                      dressing = dressing)
   131	    s = sec.s
   132	    alg = TDVP2(; trscheme = truncrank(chi_max))
   133	    envs = environments(psi, sec.H)
   134	
   135	    vals = collect(-length(W):length(W))
   136	    samples = MemorySample[]
   137	    function sample!(t)
   138	        n = staggered_profile(psi)
   139	        est = wall_estimators(n, s, W)
   140	        _, p = window_charge_law(psi, W; weight = 1.0)
   141	        Qint = sum(v * pv for (v, pv) in zip(vals, p))
   142	        Qhat = Qint - s * (2cut - first(W) - last(W) + 1)
   143	        leak = sum(abs, est.wall_density[1:min(edge_guard, end)]) +
   144	               sum(abs, est.wall_density[max(1, end - edge_guard + 1):end])
   145	        push!(samples, MemorySample(t, est.X1, est.X2, est.X3, est.wall_weight,
   146	                                    Qint, Qhat, window_energy(sec, psi), norm(psi),
   147	                                    leak, p, n))
   148	        verbose && @printf("t=%6.2f X1=%8.3f X2=%8.3f Q=%9.4f E=%9.5f leak=%.2e\n",
   149	                           t, est.X1, est.X2, Qhat, samples[end].energy, leak)
   150	        return nothing
   151	    end
   152	
   153	    cert_i = coset_certificate(psi, W, s, cut)
   154	    packet_E = window_energy(sec, psi)
   155	    sample!(0.0)
   156	    for step in 1:nsteps
   157	        psi, envs = timestep(psi, sec.H, 0.0, dt, alg, envs)
   158	        step % sample_every == 0 && sample!(step * dt)
   159	    end
   160	    cert_f = coset_certificate(psi, W, s, cut)
   161	
   162	    ts = [sm.t for sm in samples]
   163	    X1 = [sm.X1 for sm in samples]
   164	    X2 = [sm.X2 for sm in samples]
   165	    X3 = [sm.X3 for sm in samples]
   166	
   167	    # readout times: wall padded from both edges of W by ≥ 2σ (D13(a) demands the
   168	    # kink core padded from both edges; 2σ leaves ~5 % of the packet outside),
   169	    # and the packet not yet leaking into the frozen boundary
   170	    pad = max(2 * sigma, 3.0)
   171	    ok = [first(W) - 1 + pad <= X1[i] <= last(W) - pad && samples[i].edge_leak < leak_tol
   172	          for i in eachindex(samples)]
   173	    idx = findall(ok)
   174	    if length(idx) >= 2
   175	        i0, i1 = first(idx), last(idx)
   176	        tm, tp = ts[i0], ts[i1]
   177	        dx1 = X1[i1] - X1[i0]; dx2 = X2[i1] - X2[i0]; dx3 = X3[i1] - X3[i0]
   178	        nu = samples[i0].Q_hat - samples[i1].Q_hat
   179	        dxq = -nu / (2s)
   180	        coeff = abs(dx2) > 1e-9 ? -nu / dx2 : NaN
   181	        vmeas = trajectory_velocity(ts, X2, (tm, tp))
   182	        vwin = (tm, tp)
   183	        Er = [samples[i].energy for i in i0:i1]
   184	        edrift = maximum(abs.(Er .- Er[1]))
   185	    else
   186	        i0 = i1 = 0
   187	        tm = tp = NaN
   188	        dx1 = dx2 = dx3 = nu = dxq = coeff = NaN
   189	        vmeas = NaN
   190	        vwin = (NaN, NaN)
   191	        edrift = NaN
   192	    end
   193	
   194	    params = (point = sec.point, chi = sec.chi, L = L, W = (first(W), last(W)),
   195	              c0 = cut, x0 = Float64(x0), sigma = Float64(sigma), k0 = Float64(k0),
   196	              dt = Float64(dt), nsteps = nsteps, sample_every = sample_every,
   197	              chi_max = chi_max, edge_guard = edge_guard, dk = Float64(dk),
   198	              leak_tol = Float64(leak_tol), dressing = dressing)
   199	    return MemoryResult(params, s, omega0, v_theory, samples, vals, cert_i, cert_f,
   200	                        packet_E, vmeas, vwin, dx1, dx2, dx3, edrift, nu, dxq,
   201	                        coeff, tm, tp, (i0, i1))
   202	end
   203	
   204	# ---------------------------------------------------------------------------
   205	# Serialisation
   206	# ---------------------------------------------------------------------------
   207	
   208	_c(x::Real) = isfinite(x) ? Float64(x) : nothing
   209	_c(v::AbstractVector{<:Real}) = [_c(x) for x in v]
   210	
   211	"""
   212	    memory_record(r::MemoryResult; profiles=true) -> Dict{String,Any}
   213	
   214	JSON-ready record with every parameter needed to regenerate the run and every
   215	measured number, non-finite floats as `null`.
   216	"""
   217	function memory_record(r::MemoryResult; profiles::Bool = true)
   218	    p = r.params
   219	    d = Dict{String, Any}(
   220	        "protocol" => "lambdaD-kink-memory",
   221	        "J" => p.point.J, "Delta" => p.point.Delta, "D" => p.point.D,
   222	        "K" => p.point.K, "label" => p.point.label,
   223	        "chi" => p.chi, "L" => p.L, "W" => collect(p.W), "c0" => p.c0,
   224	        "x0" => p.x0, "sigma" => p.sigma, "k0" => p.k0, "dt" => p.dt,
   225	        "nsteps" => p.nsteps, "sample_every" => p.sample_every,
   226	        "chi_max" => p.chi_max, "edge_guard" => p.edge_guard, "dk" => p.dk,
   227	        "leak_tol" => p.leak_tol,
   228	        "dressing" => String(p.dressing),
   229	        "s_tail_density" => _c(r.s),
   230	        "omega_k0" => _c(r.omega0), "packet_energy" => _c(r.packet_energy),
   231	        "v_theory_dwdk" => _c(r.v_theory), "v_measured" => _c(r.v_measured),
   232	        "v_fit_window" => [_c(r.v_fit_window[1]), _c(r.v_fit_window[2])],
   233	        "t_minus" => _c(r.t_minus), "t_plus" => _c(r.t_plus),
   234	        "readout_index" => collect(r.readout_index),
   235	        "dx_X1_D13a" => _c(r.dx_X1), "dx_X2_centroid" => _c(r.dx_X2),
   236	        "dx_X3_crossing" => _c(r.dx_X3),
   237	        "energy_drift_readout" => _c(r.energy_drift_readout),
   238	        "nu_mean_escaped_charge" => _c(r.nu_mean),
   239	        "dx_from_charge" => _c(r.dx_from_charge),
   240	        "coefficient_measured" => _c(r.coefficient_measured),
   241	        "coefficient_predicted_2s" => _c(2 * r.s),
   242	        "charge_values" => r.charge_values,
   243	        "cert_initial" => Dict(String(k) => _c(v) for (k, v) in pairs(r.cert_initial)),
