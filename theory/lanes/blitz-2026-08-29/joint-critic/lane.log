    34	def block_diag(blocks: list[np.ndarray]) -> np.ndarray:
    35	    size = sum(block.shape[0] for block in blocks)
    36	    out = np.zeros((size, size), dtype=complex)
    37	    offset = 0
    38	    for block in blocks:
    39	        width = block.shape[0]
    40	        out[offset : offset + width, offset : offset + width] = block
    41	        offset += width
    42	    return out
    43	
    44	
    45	def spin_generators(j: float) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    46	    dim = int(round(2 * j + 1))
    47	    ms = np.array([j - k for k in range(dim)], dtype=float)
    48	    jp = np.zeros((dim, dim), dtype=complex)
    49	    for col, m in enumerate(ms):
    50	        if col > 0:
    51	            jp[col - 1, col] = np.sqrt((j - m) * (j + m + 1))
    52	    jm = jp.conj().T
    53	    return (jp + jm) / 2, (jp - jm) / (2j), np.diag(ms)
    54	
    55	
    56	def haar_unitary(rng: np.random.Generator, dim: int) -> np.ndarray:
    57	    raw = rng.normal(size=(dim, dim)) + 1j * rng.normal(size=(dim, dim))
    58	    qmat, rmat = np.linalg.qr(raw)
    59	    diagonal = np.diag(rmat)
    60	    phases = np.ones(dim, dtype=complex)
    61	    nonzero = np.abs(diagonal) > 0
    62	    phases[nonzero] = diagonal[nonzero] / np.abs(diagonal[nonzero])
    63	    return qmat @ np.diag(phases.conj())
    64	
    65	
    66	def invariant_sample(
    67	    rng: np.random.Generator, red: bool
    68	) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    69	    # (multiplicity, spin, central U(1) weight); the SU(2) part is nonabelian.
    70	    sectors = [(3, 0.5, 1.0), (2, 1.0, -2.0), (2, 0.0, 4.0)]
    71	    rho_blocks: list[np.ndarray] = []
    72	    centre_blocks: list[np.ndarray] = []
    73	    jx_blocks: list[np.ndarray] = []
    74	    jy_blocks: list[np.ndarray] = []
    75	    jz_blocks: list[np.ndarray] = []
    76	
    77	    for multiplicity, spin, central_weight in sectors:
    78	        jx, jy, jz = spin_generators(spin)
    79	        irrep_dim = jx.shape[0]
    80	        raw = rng.normal(size=(multiplicity, multiplicity)) + 1j * rng.normal(
    81	            size=(multiplicity, multiplicity)
    82	        )
    83	        multiplicity_density = raw @ raw.conj().T + 0.4 * np.eye(multiplicity)
    84	        rho_blocks.append(np.kron(multiplicity_density, np.eye(irrep_dim)))
    85	        centre_blocks.append(central_weight * np.eye(multiplicity * irrep_dim))
    86	        jx_blocks.append(np.kron(np.eye(multiplicity), jx))
    87	        jy_blocks.append(np.kron(np.eye(multiplicity), jy))
    88	        jz_blocks.append(np.kron(np.eye(multiplicity), jz))
    89	
    90	    rho = block_diag(rho_blocks)
    91	    centre = block_diag(centre_blocks)
    92	    jx = block_diag(jx_blocks)
    93	    jy = block_diag(jy_blocks)
    94	    jz = block_diag(jz_blocks)
    95	    rho /= np.trace(rho)
    96	
    97	    change_basis = haar_unitary(rng, rho.shape[0])
    98	    rho = change_basis @ rho @ change_basis.conj().T
    99	    centre = change_basis @ centre @ change_basis.conj().T
   100	    jx = change_basis @ jx @ change_basis.conj().T
   101	    jy = change_basis @ jy @ change_basis.conj().T
   102	    jz = change_basis @ jz @ change_basis.conj().T
   103	
   104	    if red:
   105	        # Positive but non-covariant density tensor: K rho K biases J_z.
   106	        scale = max(1.0, np.linalg.norm(jz, ord=2))
   107	        bias = np.eye(rho.shape[0]) + 0.18 * jz / scale
   108	        rho = bias @ rho @ bias
   109	        rho /= np.trace(rho)
   110	
   111	    return rho, centre, jx, jy, jz
