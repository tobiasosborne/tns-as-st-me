   114	def covariant_product_mps_sample(
   115	    rng: np.random.Generator, red: bool
   116	) -> tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
   117	    """Random chi=1 covariant MPS tensor for U(1) x SU(2).
   118	
   119	    The physical representation has four singlets of central weight 2 and one
   120	    spin-1 multiplet of central weight -1.  A random vector in the singlet
   121	    multiplicity space is an injective chi=1 tensor and an H-character line.
   122	    A random basis change makes all displayed tensors dense.
   123	    """
   124	    spin_x, spin_y, spin_z = spin_generators(1.0)
   125	    zero_singlets = np.zeros((4, 4), dtype=complex)
   126	    jx = block_diag([zero_singlets, spin_x])
   127	    jy = block_diag([zero_singlets, spin_y])
   128	    jz = block_diag([zero_singlets, spin_z])
   129	    centre = block_diag([2.0 * np.eye(4), -1.0 * np.eye(3)])
   130	
   131	    tensor = np.zeros(7, dtype=complex)
   132	    tensor[:4] = rng.normal(size=4) + 1j * rng.normal(size=4)
   133	    tensor /= np.linalg.norm(tensor)
   134	    if red:
   135	        # Add a highest-weight triplet component: the tensor leaves the
   136	        # invariant character line and acquires a semisimple density.
   137	        tensor[4] += 0.22
   138	        tensor /= np.linalg.norm(tensor)
   139	
   140	    change_basis = haar_unitary(rng, 7)
   141	    tensor = change_basis @ tensor
   142	    centre = change_basis @ centre @ change_basis.conj().T
   143	    jx = change_basis @ jx @ change_basis.conj().T
   144	    jy = change_basis @ jy @ change_basis.conj().T
   145	    jz = change_basis @ jz @ change_basis.conj().T
   146	    return tensor, centre, jx, jy, jz
   147	
