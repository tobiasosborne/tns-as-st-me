    68	def c1_profile_gate(red_profile: bool) -> float:
    69	    worst_scaled_error = 0.0
    70	    for spin in (0.5, 1.0, 1.5, 2.0):
    71	        for hard in (0.55, 1.1, 2.2, -0.8, -1.7):
    72	            chi = 1.0 if velocity(spin, hard) > 0.0 else -1.0
    73	            target = -1j * chi / (2.0 * spin * velocity(spin, hard))
    74	            if red_profile:
    75	                target *= 2.0
    76	            for soft in (2.0e-4, 1.0e-4, 5.0e-5):
    77	                signed_soft = soft if hard > 0.0 else -soft
    78	                quotient = scalar_quotient(spin, signed_soft, hard)
    79	                scaled_error = abs(quotient - target) / abs(signed_soft)
    80	                worst_scaled_error = max(worst_scaled_error, scaled_error)
    81	    require(worst_scaled_error < 25.0, "PLSZ-C1 removable profile failed")
    82	    return worst_scaled_error
