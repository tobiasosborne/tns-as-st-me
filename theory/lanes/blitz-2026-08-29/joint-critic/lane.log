     1	#!/usr/bin/env python3
     2	"""Red-capable finite checks for the compact-G memory scope shard.
     3	
     4	SG-C1 samples covariant Hermitian Lie-algebra tensors and invariant density
     5	tensors for the nonabelian compact group U(1) x SU(2).  It checks that the
     6	vacuum functional vanishes on su(2) while it may survive on the centre.
     7	
     8	SG-C2 samples a genuinely noncommuting two-time joint TPM protocol for three
     9	commuting on-site circle charges.  It checks affine-offset cancellation and
    10	Z^3 support.  ``--red`` biases the density tensor away from covariance and
    11	changes the final TPM background; both registered gates must fail.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import argparse
    17	import sys
