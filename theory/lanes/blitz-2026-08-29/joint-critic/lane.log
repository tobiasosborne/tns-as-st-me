     1	#!/usr/bin/env python3
     2	"""Finite corroboration for the scalar PROTO-LSZ witness.
     3	
     4	The gates check only the exact spin-S multiplier algebra, its removable
     5	scalar quotient, packet aggregation, and the non-uniqueness of an untyped
     6	component split.  They do not certify D24 component provenance.
     7	"""
     8	
     9	from __future__ import annotations
    10	
    11	import argparse
    12	import cmath
    13	import math
    14	import sys
    15	
    16	
    17	TOL = 2.0e-10
    18	
    19	
    20	def fail(message: str) -> None:
    21	    print(f"FAIL: {message}")
    22	    raise SystemExit(1)
    23	
    24	
    25	def require(condition: bool, message: str) -> None:
    26	    if not condition:
    27	        fail(message)
    28	
    29	
    30	def velocity(spin: float, momentum: float) -> float:
    31	    return 2.0 * spin * math.sin(momentum)
    32	
    33	
    34	def s12(spin: float, soft: float, hard: float) -> complex:
    35	    z1 = cmath.exp(1j * soft)
    36	    z2 = cmath.exp(1j * hard)
    37	    a = 1.0 + z1 * z2
    38	    b = z1 + z2
    39	    mu = (2.0 * spin - 1.0) * a + b
    40	    numerator = spin * a * b - z1 * mu
    41	    denominator = z2 * mu - spin * a * b
    42	    require(abs(denominator) > 1.0e-8, "regular-domain denominator collapsed")
    43	    return numerator / denominator
    44	
    45	
    46	def physical_multiplier(spin: float, soft: float, hard: float) -> complex:
    47	    raw = s12(spin, soft, hard)
    48	    chi = 1.0 if velocity(spin, hard) > velocity(spin, soft) else -1.0
    49	    return raw if chi > 0.0 else 1.0 / raw
    50	
    51	
    52	def scalar_quotient(spin: float, soft: float, hard: float) -> complex:
    53	    chi = 1.0 if velocity(spin, hard) > velocity(spin, soft) else -1.0
    54	    vh = velocity(spin, hard)
    55	    if soft == 0.0:
    56	        return -1j * chi / (2.0 * spin * vh)
    57	    return (physical_multiplier(spin, soft, hard) - 1.0) / (
    58	        (cmath.exp(1j * soft) - 1.0) * (2j * vh)
    59	    )
    60	
    61	
    62	def normalized_weights(size: int) -> list[float]:
    63	    raw = [1.0 + math.cos(math.pi * (j + 0.5) / size) ** 2 for j in range(size)]
    64	    total = sum(raw)
    65	    return [value / total for value in raw]
    66	
    67	
    68	def c1_profile_gate(red_profile: bool) -> float:
    69	    worst_scaled_error = 0.0
    70	    for spin in (0.5, 1.0, 1.5, 2.0):
    71	        for hard in (0.55, 1.1, 2.2, -0.8, -1.7):
    72	            chi = 1.0 if velocity(spin, hard) > 0.0 else -1.0
    73	            target = -1j * chi / (2.0 * spin * velocity(spin, hard))
    74	            if red_profile:
    75	                target *= 2.0
    76	            for soft in (2.0e-4, 1.0e-4, 5.0e-5):
    77	                signed_soft = soft if hard > 0.0 else -soft
    78	                quotient = scalar_quotient(spin, signed_soft, hard)
    79	                scaled_error = abs(quotient - target) / abs(signed_soft)
    80	                worst_scaled_error = max(worst_scaled_error, scaled_error)
    81	    require(worst_scaled_error < 25.0, "PLSZ-C1 removable profile failed")
    82	    return worst_scaled_error
    83	
    84	
    85	def exact_factor_gate(red_ward_factor: bool) -> float:
    86	    worst = 0.0
    87	    ward_factor = 1j if red_ward_factor else 2j
    88	    for spin in (0.5, 1.0, 1.5, 2.0):
    89	        for hard in (0.65, 1.25, 2.35, -0.75, -1.4):
    90	            for soft in (0.003, 0.011, 0.027):
    91	                signed_soft = soft if hard > 0.0 else -soft
    92	                multiplier = physical_multiplier(spin, signed_soft, hard)
    93	                quotient = scalar_quotient(spin, signed_soft, hard)
    94	                reconstructed = (
    95	                    (cmath.exp(1j * signed_soft) - 1.0)
    96	                    * quotient
    97	                    * ward_factor
    98	                    * velocity(spin, hard)
    99	                )
   100	                worst = max(worst, abs((multiplier - 1.0) - reconstructed))
   101	    require(worst < TOL, "PLSZ-C2 exact Ward/LSZ factor failed")
   102	    return worst
   103	
   104	
   105	def packet_and_slope_gate(red_slope: bool) -> tuple[float, float]:
   106	    worst_packet = 0.0
   107	    worst_remainder_coefficient = 0.0
   108	    u_grid = [0.35 + 0.5 * j / 16.0 for j in range(17)]
   109	    h_grid = [0.7 + 1.15 * j / 12.0 for j in range(13)]
   110	    wu = normalized_weights(len(u_grid))
   111	    wh = normalized_weights(len(h_grid))
   112	    for spin in (0.5, 1.0, 1.5, 2.0):
   113	        slope = 1.0 / (spin + 1.0) if red_slope else 1.0 / spin
   114	        for epsilon in (0.025, 0.0125, 0.00625):
   115	            amplitude = 0j
   116	            descendant = 0j
   117	            mean = 0.0
   118	            for iu, u in enumerate(u_grid):
   119	                soft = epsilon * u
   120	                for ih, hard in enumerate(h_grid):
   121	                    weight = wu[iu] * wh[ih]
   122	                    multiplier = physical_multiplier(spin, soft, hard)
   123	                    quotient = scalar_quotient(spin, soft, hard)
   124	                    amplitude += weight * (multiplier - 1.0)
   125	                    descendant += weight * (
   126	                        (cmath.exp(1j * soft) - 1.0)
   127	                        * quotient
   128	                        * (2j * velocity(spin, hard))
   129	                    )
   130	                    mean += weight * soft
   131	            worst_packet = max(worst_packet, abs(amplitude - descendant))
   132	            coefficient = abs(amplitude - 1j * slope * mean) / (epsilon * epsilon)
   133	            worst_remainder_coefficient = max(worst_remainder_coefficient, coefficient)
   134	    require(worst_packet < TOL, "PLSZ-C3 packet factorization failed")
   135	    require(
   136	        worst_remainder_coefficient < 10.0,
   137	        "PLSZ-C3 first-jet remainder failed",
   138	    )
   139	    return worst_packet, worst_remainder_coefficient
   140	
   141	
   142	def component_nonuniqueness_gate(red_split: bool) -> tuple[float, float]:
   143	    """Show that an untyped split is not determined by its scalar sum."""
   144	    maximum_sum_error = 0.0
   145	    minimum_linear_ratio = math.inf
   146	    for epsilon in (0.04, 0.02, 0.01, 0.005):
   147	        total = complex(0.2 * epsilon * epsilon, epsilon)
   148	        shift = complex(0.3, -0.2) * epsilon
   149	        descendant = total + shift
   150	        orthogonal = -shift
   151	        if red_split:
   152	            orthogonal = 0j
   153	        reconstructed = descendant + orthogonal
   154	        maximum_sum_error = max(maximum_sum_error, abs(total - reconstructed))
   155	        minimum_linear_ratio = min(minimum_linear_ratio, abs(shift) / epsilon)
   156	    require(maximum_sum_error < TOL, "PLSZ-C4 compensating component split failed")
   157	    require(minimum_linear_ratio > 0.3, "PLSZ-C4 linear ambiguity was not live")
   158	    return maximum_sum_error, minimum_linear_ratio
   159	
