   161	def parse_args() -> argparse.Namespace:
   162	    parser = argparse.ArgumentParser()
   163	    parser.add_argument("--red-profile", action="store_true")
   164	    parser.add_argument("--red-ward-factor", action="store_true")
   165	    parser.add_argument("--red-slope", action="store_true")
   166	    parser.add_argument("--red-split", action="store_true")
   167	    args = parser.parse_args()
   168	    red_count = sum(
