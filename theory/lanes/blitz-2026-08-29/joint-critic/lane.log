   149	def check_c1(red: bool) -> dict[str, float]:
   150	    rng = np.random.default_rng(20260829)
   151	    max_covariance = 0.0
   152	    max_lie_residue = 0.0
   153	    max_semisimple_density = 0.0
   154	    max_ad_invariance = 0.0
   155	    max_central_density = 0.0
   156	    max_mps_covariance = 0.0
   157	    max_mps_semisimple_density = 0.0
   158	    max_mps_central_residue = 0.0
   159	
   160	    for _ in range(24):
   161	        rho, centre, jx, jy, jz = invariant_sample(rng, red)
   162	        generators = (jx, jy, jz)
   163	        for generator in generators:
   164	            max_covariance = max(
   165	                max_covariance, np.linalg.norm(rho @ generator - generator @ rho)
   166	            )
   167	            max_semisimple_density = max(
   168	                max_semisimple_density, abs(np.trace(rho @ generator))
   169	            )
   170	        max_lie_residue = max(
   171	            max_lie_residue, np.linalg.norm(jx @ jy - jy @ jx - 1j * jz)
   172	        )
   173	        max_central_density = max(max_central_density, abs(np.trace(rho @ centre)))
   174	
   175	        axis = rng.normal(size=3)
   176	        axis /= np.linalg.norm(axis)
   177	        theta = rng.uniform(-np.pi, np.pi)
   178	        rotation_generator = axis[0] * jx + axis[1] * jy + axis[2] * jz
   179	        values, vectors = np.linalg.eigh(rotation_generator)
   180	        unitary = (vectors * np.exp(1j * theta * values)) @ vectors.conj().T
   181	        probe_coefficients = rng.normal(size=3)
   182	        probe = sum(c * g for c, g in zip(probe_coefficients, generators))
   183	        transformed = unitary @ probe @ unitary.conj().T
   184	        max_ad_invariance = max(
   185	            max_ad_invariance,
   186	            abs(np.trace(rho @ transformed) - np.trace(rho @ probe)),
   187	        )
   188	
   189	        tensor, mps_centre, mps_jx, mps_jy, mps_jz = covariant_product_mps_sample(
   190	            rng, red
   191	        )
   192	        for generator in (mps_jx, mps_jy, mps_jz):
   193	            max_mps_covariance = max(max_mps_covariance, np.linalg.norm(generator @ tensor))
   194	            max_mps_semisimple_density = max(
   195	                max_mps_semisimple_density, abs(np.vdot(tensor, generator @ tensor))
   196	            )
   197	        max_mps_central_residue = max(
   198	            max_mps_central_residue,
   199	            np.linalg.norm((mps_centre - 2.0 * np.eye(7)) @ tensor),
   200	        )
   201	
   202	    require(
   203	        max(max_semisimple_density, max_mps_semisimple_density) < TOL,
   204	        "SG-C1 semisimple-density gate: "
   205	        f"density={max(max_semisimple_density, max_mps_semisimple_density):.3e}, "
   206	        f"state_covariance={max_covariance:.3e}, mps_covariance={max_mps_covariance:.3e}",
   207	    )
   208	    require(max_covariance < TOL, f"SG-C1 covariance residue={max_covariance:.3e}")
   209	    require(
   210	        max_mps_covariance < TOL,
   211	        f"SG-C1 random MPS covariance residue={max_mps_covariance:.3e}",
   212	    )
   213	    require(
   214	        max_mps_central_residue < TOL,
   215	        f"SG-C1 random MPS central-character residue={max_mps_central_residue:.3e}",
   216	    )
   217	    require(max_lie_residue < TOL, f"SG-C1 Lie residue={max_lie_residue:.3e}")
   218	    require(
   219	        max_ad_invariance < TOL,
