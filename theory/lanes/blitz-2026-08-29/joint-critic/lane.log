   264	        for b in window_charges
   265	    )
   266	
   267	    basis_weights = np.array(
   268	        [weights[a] + weights[b] for a in range(dim_site) for b in range(dim_site)]
   269	    )
   270	    affine_offset = 2 * kappa - background
   271	    eigenvalues_minus = basis_weights + affine_offset
   272	    eigenvalues_plus = eigenvalues_minus.copy()
   273	    if red:
   274	        # Measuring a different final background violates the same-window premise.
   275	        eigenvalues_plus[:, 0] += np.sqrt(2.0) / 10.0
   276	
   277	    dimension = dim_site**2
   278	    u_minus = haar_unitary(rng, dimension)
   279	    u_plus = haar_unitary(rng, dimension)
   280	    psi = rng.normal(size=dimension) + 1j * rng.normal(size=dimension)
   281	    psi /= np.linalg.norm(psi)
   282	    initial_weights = np.abs(u_minus.conj().T @ psi) ** 2
   283	    transitions = np.abs(u_plus.conj().T @ u_minus) ** 2
   284	    joint_probabilities = transitions * initial_weights[np.newaxis, :]
   285	
   286	    probability_residue = abs(np.sum(joint_probabilities) - 1.0)
   287	    max_lattice_residue = 0.0
   288	    active_atoms = 0
   289	    for final_index in range(dimension):
   290	        for initial_index in range(dimension):
