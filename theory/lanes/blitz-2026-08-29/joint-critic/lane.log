===== checker =====
     1	#!/usr/bin/env python3
     2	"""Red-capable arithmetic checks for ML1/ML6's explicit D6 fiber formulas.
     3	
     4	This checks only the scattering modulus, bound overlap/geometric sum, its
     5	soft derivative, and the continuum/bound gap.  It does not test wave-operator
     6	existence or a limit interchange.
     7	"""
     8	
     9	import argparse
    10	import cmath
    11	import math
    12	
    13	
    14	def bound_overlap_formula(k: float, h: float, mutate: bool = False) -> float:
    15	    K = h + k
    16	    q = (h - k) / 2.0
    17	    c = math.cos(K / 2.0)
    18	    numerator_core = math.cos(q) + c if mutate else math.cos(q) - c
    19	    return (
    20	        2.0
    21	        * math.sqrt(max(0.0, 1.0 - c * c))
    22	        * numerator_core
    23	        / (1.0 - 2.0 * c * math.cos(q) + c * c)
    24	    )
    25	
    26	
    27	def bound_overlap_sum(k: float, h: float, rmax: int = 6000) -> complex:
    28	    K = h + k
    29	    q = (h - k) / 2.0
    30	    c = math.cos(K / 2.0)
    31	    prefactor = math.sqrt(max(0.0, 1.0 - c * c))
    32	    return prefactor * sum(
    33	        (c ** (r - 1)) * (cmath.exp(1j * q * r) + cmath.exp(-1j * q * r))
    34	        for r in range(1, rmax + 1)
    35	    )
    36	
    37	
    38	def scattering(K: float, q: float, mutate: bool = False) -> complex:
    39	    c = math.cos(K / 2.0)
    40	    denominator = cmath.exp(1j * q) + c if mutate else cmath.exp(1j * q) - c
    41	    return (c - cmath.exp(-1j * q)) / denominator
    42	
    43	
    44	def main() -> int:
    45	    parser = argparse.ArgumentParser()
    46	    parser.add_argument("--red-bound", action="store_true")
    47	    parser.add_argument("--red-unitarity", action="store_true")
    48	    args = parser.parse_args()
    49	
    50	    failures = []
    51	    hard_grid = [0.4, 0.7, 1.1, 1.6, 2.1, 2.5]
    52	
    53	    beta_zero = max(
    54	        abs(bound_overlap_formula(0.0, h, mutate=args.red_bound)) for h in hard_grid
    55	    )
    56	    if beta_zero > 2.0e-12:
    57	        failures.append("G1 bound overlap at k=0")
    58	
    59	    sum_error = 0.0
    60	    for h in hard_grid:
    61	        for k in (-0.03, 0.02):
    62	            exact = bound_overlap_formula(k, h, mutate=args.red_bound)
    63	            direct = bound_overlap_sum(k, h)
    64	            sum_error = max(sum_error, abs(exact - direct))
    65	    if sum_error > 2.0e-10:
    66	        failures.append("G2 geometric-series overlap")
    67	
    68	    slope_error = 0.0
    69	    step = 1.0e-6
    70	    for h in hard_grid:
    71	        derivative = (
    72	            bound_overlap_formula(step, h, mutate=args.red_bound)
    73	            - bound_overlap_formula(-step, h, mutate=args.red_bound)
    74	        ) / (2.0 * step)
    75	        slope_error = max(slope_error, abs(derivative - 2.0))
    76	    if slope_error > 2.0e-7:
    77	        failures.append("G3 soft bound-overlap derivative")
    78	
    79	    unitarity_error = 0.0
    80	    min_gap = float("inf")
    81	    for h in hard_grid:
    82	        for k in (-0.04, 0.01, 0.04):
    83	            K = h + k
    84	            q = (h - k) / 2.0
    85	            c = math.cos(K / 2.0)
    86	            s_value = scattering(K, q, mutate=args.red_unitarity)
    87	            unitarity_error = max(unitarity_error, abs(abs(s_value) - 1.0))
    88	            gap = abs(cmath.exp(1j * q) - c) ** 2
    89	            min_gap = min(min_gap, gap)
    90	    if unitarity_error > 2.0e-12:
    91	        failures.append("G4 scattering unitarity")
    92	    if min_gap <= 0.0:
    93	        failures.append("G5 positive bound/continuum gap")
    94	
    95	    print(f"beta_zero={beta_zero:.3e}")
    96	    print(f"geometric_sum_error={sum_error:.3e}")
    97	    print(f"soft_slope_error={slope_error:.3e}")
    98	    print(f"unitarity_error={unitarity_error:.3e}")
    99	    print(f"sample_min_gap_over_J={min_gap:.6e}")
   100	    if failures:
   101	        print("FAIL: " + "; ".join(failures))
   102	        return 1
   103	    print("PASS")
   104	    return 0
   105	
   106	
   107	if __name__ == "__main__":
   108	    raise SystemExit(main())

