     3	
     4	The proof is analytic.  This checker exhausts small frozen-boundary chains,
     5	compares their incoming <=3-DW component with the claimed Fano graph, checks
     6	the charge/leg bookkeeping and product-basis locality, and has an intentional
     7	right-tail mutation for the required red-capability demonstration.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import argparse
    13	# Standard-library only, so the falsifier is reproducible without dependencies.
    14	from collections import Counter, deque
    15	from itertools import combinations
    16	
    17	
    18	def walls(spins: tuple[int, ...]) -> tuple[int, ...]:
    19	    return tuple(i for i in range(len(spins) - 1) if spins[i] != spins[i + 1])
    20	
    21	
    22	def from_walls(size: int, wall_set: tuple[int, ...]) -> tuple[int, ...]:
    23	    result = []
    24	    spin = 1
    25	    wall_lookup = set(wall_set)
    26	    for site in range(size):
    27	        result.append(spin)
    28	        if site in wall_lookup:
    29	            spin *= -1
    30	    return tuple(result)
    31	
    32	
    33	def enumerate_basis(size: int, mu: int) -> set[tuple[int, ...]]:
    34	    """Sites are 0,...,size-1; endpoint spins are frozen up/down."""
    35	    n_down = size - 1 - mu
    36	    basis: set[tuple[int, ...]] = set()
    37	    for down_sites in combinations(range(size), n_down):
    38	        state = [1] * size
    39	        for site in down_sites:
    40	            state[site] = -1
    41	        state_t = tuple(state)
    42	        if state_t[0] != 1 or state_t[-1] != -1:
    43	            continue
    44	        if len(walls(state_t)) in (1, 3):
    45	            basis.add(state_t)
    46	    return basis
    47	
    48	
    49	def neighbours(
    50	    state: tuple[int, ...], basis: set[tuple[int, ...]]
    51	) -> set[tuple[int, ...]]:
    52	    result = set()
    53	    for bond in walls(state):
    54	        changed = list(state)
    55	        changed[bond], changed[bond + 1] = changed[bond + 1], changed[bond]
    56	        changed_t = tuple(changed)
    57	        if changed_t in basis:
    58	            result.add(changed_t)
    59	    return result
    60	
    61	
    62	def component(
    63	    start: tuple[int, ...], basis: set[tuple[int, ...]]
    64	) -> set[tuple[int, ...]]:
    65	    seen = {start}
    66	    queue = deque([start])
    67	    while queue:
    68	        state = queue.popleft()
    69	        for candidate in neighbours(state, basis):
    70	            if candidate not in seen:
    71	                seen.add(candidate)
    72	                queue.append(candidate)
    73	    return seen
    74	
    75	
    76	def graph_states(size: int, mu: int, red: bool) -> dict[object, tuple[int, ...]]:
    77	    result: dict[object, tuple[int, ...]] = {"d": from_walls(size, (mu,))}
    78	    n_min = 1 - mu
    79	    n_max = size - mu - 3
    80	    for n in range(n_min, 1):
    81	        result[n] = from_walls(size, (mu + n - 1, mu + n, mu + 1))
    82	    for n in range(1, n_max + 1):
    83	        shift = 1 if red else 0
    84	        result[n] = from_walls(
    85	            size, (mu - 1, mu + n + shift, mu + n + 1 + shift)
    86	        )
    87	    return result
    88	
    89	
    90	def check_locality(
    91	    graph: dict[object, tuple[int, ...]], mu: int, size: int
    92	) -> int:
    93	    """Check the exact eventual channel constants for every interior window."""
    94	    checks = 0
    95	    kink_left = from_walls(size, (mu + 1,))
    96	    kink_right = from_walls(size, (mu - 1,))
    97	    numeric_labels = sorted(label for label in graph if isinstance(label, int))
    98	    for lo in range(1, size - 1):
    99	        for hi in range(lo, size - 1):
   100	            window = set(range(lo, hi + 1))
   101	            outside = set(range(size)) - window
   102	            for label in numeric_labels:
   103	                state = graph[label]
   104	                moving_site = mu + label if label <= 0 else mu + label + 1
   105	                if moving_site in window:
   106	                    continue
   107	                reference = kink_left if label <= 0 else kink_right
   108	                assert all(state[x] == reference[x] for x in window)
   109	                for other_label in numeric_labels:
   110	                    if other_label == label:
   111	                        continue
   112	                    other = graph[other_label]
   113	                    # Distinct product states can be connected by an arbitrary
   114	                    # W-local operator only if they coincide outside W.
   115	                    if all(state[x] == other[x] for x in outside):
   116	                        other_moving = (
   117	                            mu + other_label
   118	                            if other_label <= 0
   119	                            else mu + other_label + 1
   120	                        )
   121	                        assert other_moving in window
   122	                checks += 1
   123	    return checks
   124	
   125	
   126	def run(red: bool) -> tuple[int, int, int]:
   127	    volumes = 0
   128	    vertices = 0
   129	    locality_checks = 0
   130	    for size in range(7, 17):
   131	        for mu in range(2, size - 3):
   132	            basis = enumerate_basis(size, mu)
   133	            expected = graph_states(size, mu, red)
   134	            start = expected[min(label for label in expected if isinstance(label, int))]
   135	            actual_component = component(start, basis)
   136	            assert set(expected.values()) == actual_component
   137	            assert len(expected) == size - 2
   138	            assert len(expected) == len(set(expected.values()))
   139	
   140	            reverse = {state: label for label, state in expected.items()}
   141	            actual_edges = set()
   142	            for state in actual_component:
   143	                for other in neighbours(state, basis):
   144	                    if other in actual_component:
   145	                        actual_edges.add(frozenset((reverse[state], reverse[other])))
   146	            numeric = sorted(label for label in expected if isinstance(label, int))
   147	            claimed_edges = {
   148	                frozenset((left, right)) for left, right in zip(numeric, numeric[1:])
   149	            }
   150	            claimed_edges.add(frozenset((0, "d")))
   151	            assert actual_edges == claimed_edges
   152	
   153	            degree_histogram = Counter(
   154	                sum(label in edge for edge in actual_edges) for label in expected
   155	            )
   156	            assert degree_histogram == Counter({2: size - 6, 1: 3, 3: 1})
   157	            assert len(walls(expected["d"])) == 1
   158	            assert all(
   159	                len(walls(state)) == 3
   160	                for label, state in expected.items()
   161	                if label != "d"
   162	            )
   163	
   164	            # The conserved finite-volume charge is B-N_down=mu.  On the
   165	            # asymptotic representatives it decomposes as kink+leg.
   166	            assert (mu + 1) - 1 == mu  # incoming/reflected leg charge -1
   167	            assert (mu - 1) + 1 == mu  # transmitted leg charge +1
   168	            assert mu == mu  # side state is the pure kink K_mu
   169	
   170	            locality_checks += check_locality(expected, mu, size)
   171	            volumes += 1
   172	            vertices += len(expected)
   173	    return volumes, vertices, locality_checks
   174	
   175	
   176	def main() -> int:
   177	    parser = argparse.ArgumentParser()
   178	    parser.add_argument("--red", action="store_true")
   179	    args = parser.parse_args()
   180	    try:
   181	        volumes, vertices, locality_checks = run(args.red)
   182	    except (AssertionError, KeyError) as exc:
   183	        if args.red:
   184	            print("RED-OK: shifted right-tail mutation was detected")
   185	            return 1
   186	        print(f"FAIL: {exc!r}")
   187	        return 1
   188	    if args.red:
   189	        print("RED-FAIL: shifted right-tail mutation escaped detection")
   190	        return 2
   191	    print(
   192	        "PASS: "
   193	        f"{volumes} volume/charge pairs, {vertices} component vertices, "
   194	        f"{locality_checks} local-tail checks"
   195	    )
   196	    return 0
   197	
   198	
   199	if __name__ == "__main__":
   200	    raise SystemExit(main())

