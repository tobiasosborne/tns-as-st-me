    34	def s12(spin: float, soft: float, hard: float) -> complex:
    35	    z1 = cmath.exp(1j * soft)
    36	    z2 = cmath.exp(1j * hard)
    37	    a = 1.0 + z1 * z2
    38	    b = z1 + z2
    39	    mu = (2.0 * spin - 1.0) * a + b
    40	    numerator = spin * a * b - z1 * mu
    41	    denominator = z2 * mu - spin * a * b
    42	    require(abs(denominator) > 1.0e-8, "regular-domain denominator collapsed")
    43	    return numerator / denominator
    44	
    45	
    46	def physical_multiplier(spin: float, soft: float, hard: float) -> complex:
    47	    raw = s12(spin, soft, hard)
    48	    chi = 1.0 if velocity(spin, hard) > velocity(spin, soft) else -1.0
    49	    return raw if chi > 0.0 else 1.0 / raw
    50	
    51	
    52	def scalar_quotient(spin: float, soft: float, hard: float) -> complex:
    53	    chi = 1.0 if velocity(spin, hard) > velocity(spin, soft) else -1.0
    54	    vh = velocity(spin, hard)
    55	    if soft == 0.0:
    56	        return -1j * chi / (2.0 * spin * vh)
    57	    return (physical_multiplier(spin, soft, hard) - 1.0) / (
    58	        (cmath.exp(1j * soft) - 1.0) * (2j * vh)
    59	    )
    60	
    61	
    62	def normalized_weights(size: int) -> list[float]:
    63	    raw = [1.0 + math.cos(math.pi * (j + 0.5) / size) ** 2 for j in range(size)]
    64	    total = sum(raw)
    65	    return [value / total for value in raw]
