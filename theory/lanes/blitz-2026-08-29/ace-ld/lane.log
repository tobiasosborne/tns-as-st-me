                f"LD-C5: nu=0 weight {p0:.4f} != measured |r|^2 {r2:.4f}")
        require(abs(ptr - t2) < 1e-3,
                f"LD-C5: transit weight {ptr:.4f} != measured |t|^2 {t2:.4f}")
        smom = sum(nu * p for nu, p in law.items())
