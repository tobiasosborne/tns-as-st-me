from __future__ import annotations

import argparse
import sys
from itertools import combinations

import numpy as np

# --------------------------------------------------------------- constants --
# FREE battery
N_FREE = 8192
XC_FREE = N_FREE // 2
HALF_W = 16                    # window half-width: W = [XC-16, XC+16]
